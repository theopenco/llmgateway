# LLMGateway Unified Docker Environment Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Database password (CHANGE THIS!)
POSTGRES_PASSWORD=your_secure_password_here

# Authentication secret (must be at least 32 characters, generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here-must-be-32+

# Secret used to HMAC-hash logged upstream provider API keys and to encrypt
# BYOK provider tokens at rest. Accepts a comma-separated keyring (newest
# first) during secret rotation; older entries only decrypt existing
# provider-key ciphertexts.
GATEWAY_API_KEY_HASH_SECRET=your-api-key-hash-secret-here

# Signed Enterprise or white-label license used in production.
LLMGATEWAY_ENTERPRISE_LICENSE=

# Secret used to sign the short-lived playback URLs handed out for generated
# videos. Required whenever video generation is enabled — without it completed
# video jobs cannot hand back a playback link.
LLM_VIDEO_CONTENT_JWT_SECRET=your-video-content-jwt-secret-here

# Shared secret the API uses to tell the gateway that a request is the
# onboarding wizard's first call, which is served without charging for it. A
# brand new organization has 0 credits, so without this the first thing a user
# does returns a 402. The call still runs on the account's own API key, so it
# appears in their logs and usage — only the price is waived.
# Leave empty to bill that call normally. Deliberately has no placeholder: any
# non-empty string switches sponsorship on, so a well-known default would let
# anyone who has read this file have their calls served free.
ONBOARDING_SPONSOR_SECRET=

# =============================================================================
# URLS (Update for your domain in production)
# =============================================================================

UI_URL=http://localhost:3002
PLAYGROUND_URL=http://localhost:3003
CODE_URL=http://localhost:3004
DOCS_URL=http://localhost:3005
ADMIN_URL=http://localhost:3006
API_URL=http://localhost:4002
API_BACKEND_URL=http://localhost:4002

# Header the edge writes the client IP into. This is the ONLY header trusted
# for rate limits and IP allow-lists — there is no fallback chain. Required in
# production; the hosted deployment sets it to X-Client-Ip, which the load
# balancer overwrites so a caller cannot forge it. Defaults to
# X-Forwarded-For, which is only correct behind a proxy that overwrites it.
CLIENT_IP_HEADER=
ORIGIN_URLS=http://localhost:3002

# Browser origins allowed to call the gateway cross-origin. Comma-separated full
# origins; a leading "*." label matches any subdomain. Empty means no CORS.
# GATEWAY_CORS_ORIGINS=

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Passkey configuration (update for your domain)
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=LLMGateway

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# Add API keys for the providers you want to use
# You don't need all of them - only add the ones you plan to use

# OpenAI
LLM_OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic
LLM_ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google AI Studio
LLM_GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# Glacier
LLM_GLACIER_API_KEY=your_glacier_key_here
LLM_GLACIER_BASE_URL=https://your-glacier-base-url

# Google Vertex AI
LLM_GOOGLE_VERTEX_API_KEY=your_google_vertex_key_here
LLM_GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
LLM_GOOGLE_VERTEX_REGION=global

# Vertex AI (OpenAI-compatible) — for partner models like xAI Grok
# Paste the full service account JSON (single-line, escaped) as the value.
LLM_VERTEX_OPENAI_SERVICE_ACCOUNT_JSON=
LLM_VERTEX_OPENAI_PROJECT=your_google_cloud_project_id
LLM_VERTEX_OPENAI_REGION=global

# Inference.net
LLM_INFERENCE_NET_API_KEY=your_inference_net_key_here

# Together.ai
LLM_TOGETHER_AI_API_KEY=your_together_ai_key_here

# SCX.ai
LLM_SCX_AI_API_KEY=your_scx_ai_key_here

# RanoAI
LLM_RANOAI_API_KEY=your_ranoai_key_here

# Baidu (Qianfan)
LLM_BAIDU_API_KEY=your_baidu_qianfan_key_here

# Mistral
LLM_MISTRAL_API_KEY=your_mistral_key_here

# Moonshot
LLM_MOONSHOT_API_KEY=your_moonshot_key_here

# Novita AI
LLM_NOVITA_AI_API_KEY=your_novita_ai_key_here

# xAI
LLM_X_AI_API_KEY=your_xai_key_here

# Groq
LLM_GROQ_API_KEY=your_groq_key_here

# DeepSeek
LLM_DEEPSEEK_API_KEY=your_deepseek_key_here

# Xiaomi MiMo
LLM_XIAOMI_API_KEY=your_xiaomi_key_here
# LLM_XIAOMI_BASE_URL=https://api.xiaomimimo.com

# Perplexity
LLM_PERPLEXITY_API_KEY=your_perplexity_key_here

# Alibaba
LLM_ALIBABA_API_KEY=your_alibaba_key_here

# Nebius
LLM_NEBIUS_API_KEY=your_nebius_key_here

# Fireworks AI
LLM_FIREWORKS_API_KEY=your_fireworks_key_here

# NanoGPT
LLM_NANO_GPT_API_KEY=your_nanogpt_key_here

# Z.ai
LLM_Z_AI_API_KEY=your_zai_key_here

# AWS Bedrock
LLM_AWS_BEDROCK_API_KEY=your_aws_bedrock_key_here

# AWS Mantle (Bedrock Mantle - OpenAI models on AWS)
LLM_AWS_MANTLE_API_KEY=your_aws_mantle_key_here

# Azure
LLM_AZURE_API_KEY=your_azure_key_here

# Azure AI Foundry (third-party models like Grok, Llama, Mistral)
LLM_AZURE_AI_FOUNDRY_API_KEY=your_azure_ai_foundry_key_here
LLM_AZURE_AI_FOUNDRY_RESOURCE=your_azure_ai_foundry_resource_here

# CanopyWave
LLM_CANOPY_WAVE_API_KEY=your_canopywave_key_here

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Resend configuration - needed for transactional emails and contact management

RESEND_API_KEY=your_resend_api_key_here
RESEND_AUDIENCE_ID=your_resend_audience_id_here
# Newsletter topic ID for Resend topic-based subscriptions
RESEND_NEWSLETTER_TOPIC_ID=your_resend_newsletter_topic_id_here

# =============================================================================
# ANALYTICS (OPTIONAL)
# =============================================================================
# PostHog analytics - remove if you don't want analytics

POSTHOG_KEY=your_posthog_project_key
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# PAYMENT PROCESSING (OPTIONAL)
# =============================================================================
# Stripe configuration - only needed if you want to enable billing

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Optional: Stripe sandbox keys for the LLM SDK. When set, `sk_test_…` platform
# secret keys route end-user wallet top-ups through the Stripe sandbox so
# developers can test payments without real charges.
STRIPE_SECRET_KEY_TEST=sk_test_your_stripe_sandbox_secret_key
STRIPE_WEBHOOK_SECRET_TEST=whsec_your_stripe_sandbox_webhook_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_plan_price_id
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_plan_price_id

# Optional override for the admin dashboard's 3D Secure setting (`any` or
# `challenge`), which requests 3DS when a card is added. Leave unset to use the
# admin setting. Charges themselves are never challenged.
# STRIPE_FORCE_3DS=challenge

# Dev Plans Stripe Price IDs (for devpass.llmgateway.io)
STRIPE_DEV_PLAN_LITE_PRICE_ID=price_your_dev_plan_lite_price_id
STRIPE_DEV_PLAN_PRO_PRICE_ID=price_your_dev_plan_pro_price_id
STRIPE_DEV_PLAN_MAX_PRICE_ID=price_your_dev_plan_max_price_id

# Dev Plan Credits Multiplier (credits = price * multiplier, default: 3)
DEV_PLAN_CREDITS_MULTIPLIER=3
