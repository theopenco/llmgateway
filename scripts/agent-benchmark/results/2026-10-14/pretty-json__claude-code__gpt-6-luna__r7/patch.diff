+  it('Should pass through JSON responses with an empty or invalid body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Test': 'preserved',
+        },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not JSON', {
+        status: 502,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Test': 'preserved',
+        },
+      })
+    )
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Test')).toBe('preserved')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('preserved')
+    expect(await invalidRes.text()).toBe('not JSON')
+  })
+
+  it('Should pass through bodyless JSON responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+        },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '12',
+        },
+      })
+    )
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(noContentRes.headers.get('Content-Length')).toBe('0')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(notModifiedRes.headers.get('Content-Length')).toBe('12')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should remove Content-Length from prettified JSON responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should not fail when another middleware has read the response body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () =>
+      new Response('not JSON', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'X-Test': 'preserved' },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('X-Test')).toBe('preserved')
+  })
+
