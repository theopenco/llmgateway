+  it('Should pass through responses with a JSON content-type but no parseable JSON body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, { 'Content-Type': 'application/json' })
+    )
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('Internal Server Error', 200, { 'Content-Type': 'application/json' })
+    )
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(await invalidRes.text()).toBe('Internal Server Error')
+  })
+
+  it('Should pass through a response whose body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/consumed', async () => {
+      const res = new Response('{"message":"Hono!"}', {
+        headers: { 'Content-Type': 'application/json' },
+      })
+      await res.text()
+      return res
+    })
+
+    const res = await app.request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should remove the original Content-Length header when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    const body = '{"message":"Hono!"}'
+    app.get('/', (c) =>
+      c.newResponse(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should keep the original Content-Length header when passing an unparseable body through', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('Internal Server Error', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '21',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('21')
+    expect(await res.text()).toBe('Internal Server Error')
+  })
+
