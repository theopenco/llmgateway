     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        // Parse a clone so that the original response body is left untouched
+        // when it cannot be parsed as JSON (e.g. empty body, 204/304, invalid
+        // body, or already consumed), so it can pass through unchanged.
+        const obj = await c.res.clone().json()
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // Body is not valid JSON (e.g. empty body, 204/304, or already consumed),
+        // so pass the response through unchanged.
+      }
     }
   }
