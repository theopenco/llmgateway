diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..4e21f10 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -2,6 +2,76 @@ import { Hono } from '../../hono'
 import { prettyJSON } from '.'
 
 describe('JSON pretty by Middleware', () => {
+  describe.each([false, true])('with force: %s', (force) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 502, body: 'not valid JSON' },
+    ])('Should preserve an unparseable JSON response: %j', async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      const response = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a JSON response whose body was already read', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      const body = '{"message":"Hono!"}'
+      const response = new Response(body, {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+        },
+      })
+      const headers = [...response.headers]
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res).toBe(response)
+      expect(res.status).toBe(200)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      const body = '{"message":"Hono!"}'
+      app.get('/', (c) => {
+        c.header('Content-Length', String(body.length))
+        c.header('X-Custom', 'preserved')
+        return c.json({ message: 'Hono!' }, 201)
+      })
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res.status).toBe(201)
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+    })
+  })
+
   it('Should return pretty JSON output', async () => {
     const app = new Hono()
     app.use('*', prettyJSON())
