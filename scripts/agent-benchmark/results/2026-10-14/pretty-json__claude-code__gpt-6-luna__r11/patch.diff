+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse(null, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'preserved',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not JSON', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+    app.use('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/consumed', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/empty', 200, '', '0'],
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+      ['/invalid', 200, 'not JSON', '8'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(await res.text()).toBe(body)
+    }
+
+    const consumedResponse = await app.request('http://localhost/consumed')
+    expect(consumedResponse.status).toBe(200)
+    expect(consumedResponse.headers.get('Content-Type')).toBe('application/json')
+    expect(consumedResponse.headers.get('Content-Length')).toBe('19')
+
+    const emptyResponse = await app.request('http://localhost/empty')
+    expect(emptyResponse.headers.get('X-Test')).toBe('preserved')
+  })
+
+  it('Should remove Content-Length when returning pretty JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
