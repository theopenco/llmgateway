+  describe.each([
+    { name: 'query', options: undefined, path: '/?pretty' },
+    { name: 'force', options: { force: true }, path: '/' },
+  ])('Response preservation with $name', ({ options, path }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: ' \n\t' },
+      { status: 502, body: 'Bad Gateway' },
+      { status: 200, body: '{"message":' },
+    ])('Should preserve an unparseable body ($status, $body)', async ({ status, body }) => {
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body?.length ?? 0),
+        'X-Custom': 'preserved',
+      })
+      const response = new Response(body, { status, headers })
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', () => response)
+
+      const res = await app.request(path)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(false)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const body = '{"message":"Hono!"}'
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Custom': 'preserved',
+      })
+      const response = new Response(body, { status: 202, headers })
+      let consumedBody: string | undefined
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        consumedBody = await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(path)
+      expect(consumedBody).toBe(body)
+      expect(res).toBe(response)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const body = '{"message":"Hono!"}'
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', (c) =>
+        c.newResponse(body, 201, {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Custom': 'preserved',
+        })
+      )
+
+      const res = await app.request(path)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+
+      if (!options?.force) {
+        const nonPrettyRes = await app.request('/')
+        expect(nonPrettyRes.headers.get('Content-Length')).toBe(String(body.length))
+        expect(await nonPrettyRes.text()).toBe(body)
+      }
+    })
+  })
+
