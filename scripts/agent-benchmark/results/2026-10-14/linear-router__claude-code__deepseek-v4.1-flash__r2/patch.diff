diff --git a/src/router/linear-router/router.test.ts b/src/router/linear-router/router.test.ts
index ed8404b..dd088a0 100644
--- a/src/router/linear-router/router.test.ts
+++ b/src/router/linear-router/router.test.ts
@@ -77,4 +77,34 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty path segment', () => {
+    const newRouter = (route: string) => {
+      const router = new LinearRouter<string>()
+      router.add('GET', route, route)
+      return router
+    }
+
+    it('GET /u//posts does not match a label', () => {
+      const [res] = newRouter('/u/:id/posts').match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//show does not match a label', () => {
+      const [res] = newRouter('/u/:id/:action').match('GET', '/u//show')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/ does not match a trailing label', () => {
+      const [res] = newRouter('/u/:id/:action').match('GET', '/u/123/')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/posts matches a label', () => {
+      const [res] = newRouter('/u/:id/posts').match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('/u/:id/posts')
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+  })
 })
