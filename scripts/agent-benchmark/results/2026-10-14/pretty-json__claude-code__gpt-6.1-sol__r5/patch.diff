+  describe.each([
+    { name: 'query', options: undefined, path: '/?pretty' },
+    { name: 'force', options: { force: true }, path: '/' },
+  ])('$name activation', ({ options, path }) => {
+    it.each([
+      { name: '204 response', status: 204, body: null, contentLength: '0' },
+      { name: '304 response', status: 304, body: null, contentLength: '123' },
+      { name: 'empty body', status: 200, body: '', contentLength: '0' },
+      { name: 'invalid JSON', status: 502, body: '<html>Bad Gateway</html>', contentLength: '24' },
+    ])('Should pass through $name unchanged', async ({ status, body, contentLength }) => {
+      const app = new Hono()
+      const original = new Response(body, {
+        status,
+        statusText: 'Unchanged',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': contentLength,
+          'X-Upstream': 'preserved',
+        },
+      })
+      const headers = [...original.headers]
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(path)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Unchanged')
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should pass through an already-read response unchanged', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const original = new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Upstream': 'preserved',
+        },
+      })
+      const headers = [...original.headers]
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => original)
+
+      const res = await app.request(path)
+      expect(res).toBe(original)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      app.use('*', prettyJSON(options))
+      app.get('/', () => {
+        return new Response(body, {
+          status: 201,
+          statusText: 'Created',
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': String(body.length),
+            'X-Upstream': 'preserved',
+          },
+        })
+      })
+
+      const res = await app.request(path)
+      expect(res.status).toBe(201)
+      expect(res.statusText).toBe('Created')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Upstream')).toBe('preserved')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
