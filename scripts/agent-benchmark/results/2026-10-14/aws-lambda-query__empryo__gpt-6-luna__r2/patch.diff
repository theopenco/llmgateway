+describe('empty query parameter values', () => {
+  it('Should preserve empty query parameter values for version 1.0 API Gateway and ALB events', () => {
+    const queryStringParameters = {
+      empty: '',
+      present: '0',
+      omitted: undefined,
+    }
+    const apiGatewayEvent: LambdaEvent = {
+      ...baseV1Event,
+      queryStringParameters,
+    }
+    const albEvent = {
+      httpMethod: 'GET',
+      path: '/my/path',
+      headers: { host: 'id.execute-api.us-east-1.amazonaws.com' },
+      queryStringParameters,
+      body: null,
+      isBase64Encoded: false,
+      requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+    } as unknown as LambdaEvent
+
+    expect(getProcessor(apiGatewayEvent).createRequest(apiGatewayEvent).url).toBe(
+      'https://id.execute-api.us-east-1.amazonaws.com/my/path?empty=&present=0'
+    )
+    expect(getProcessor(albEvent).createRequest(albEvent).url).toBe(
+      'https://id.execute-api.us-east-1.amazonaws.com/my/path?empty=&present=0'
+    )
+  })
+})
