diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..f8e2714 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,91 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should pass through a response with an empty body and a JSON content-type', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      c.status(204)
+      c.header('Content-Type', 'application/json')
+      return c.body(null)
+    })
+    app.get('/not-modified', (c) => {
+      c.status(304)
+      c.header('Content-Type', 'application/json')
+      return c.body(null)
+    })
+    app.get('/empty', (c) =>
+      c.body('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+
+    for (const path of ['/no-content', '/not-modified']) {
+      const res = await app.request(`http://localhost${path}?pretty`)
+      expect(res.status).toBe(path === '/no-content' ? 204 : 304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    }
+
+    const emptyRes = await app.request('http://localhost/empty?pretty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(await emptyRes.text()).toBe('')
+  })
+
+  it('Should pass through a JSON content-type response whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('<html>Bad Gateway</html>', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '22',
+        'X-Origin': 'proxy',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('22')
+    expect(res.headers.get('X-Origin')).toBe('proxy')
+    expect(await res.text()).toBe('<html>Bad Gateway</html>')
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', async (c) => {
+      const res = c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+      })
+      await res.text()
+      return res
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    // The response is handed back untouched, so its body is still the consumed one
+    expect(res.bodyUsed).toBe(true)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..b5179e7 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,17 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
+      let obj: unknown
+      try {
+        // Parse a clone so the original response is left untouched when its body
+        // is empty or not valid JSON (e.g. a proxied response), or was already read.
+        obj = await c.res.clone().json()
+      } catch {
+        return
+      }
       c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      // The body changed, so the inherited Content-Length no longer matches.
+      c.res.headers.delete('Content-Length')
     }
   }
 }
