+  describe.each([
+    { mode: 'query', options: {}, url: '/?pretty' },
+    { mode: 'force', options: { force: true }, url: '/' },
+  ])('When pretty JSON is enabled by $mode', ({ options, url }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: '   ' },
+      { status: 502, body: 'not valid JSON' },
+    ])('Should preserve an unparseable JSON response: $status, $body', async ({ status, body }) => {
+      const app = new Hono()
+      const response = new Response(body, {
+        status,
+        statusText: 'Original status',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 123),
+          'X-Original': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.use('*', prettyJSON(options))
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Original status')
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      const response = new Response('{"message":"Hono!"}', {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Original': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', (c) => {
+        return c.body('{"message":"Hono!"}', 201, {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Original': 'preserved',
+        })
+      })
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Original')).toBe('preserved')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
