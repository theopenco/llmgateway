+  describe.each([
+    { name: '?pretty', options: undefined, path: '/?pretty' },
+    { name: 'force: true', options: { force: true }, path: '/' },
+  ])('With $name', ({ options, path }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 502, body: 'Upstream error' },
+      { status: 200, body: '{"message":' },
+    ])('Should preserve status $status and unparseable body $body', async ({ status, body }) => {
+      const originalResponse = new Response(body, {
+        status,
+        statusText: 'Original response',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'original',
+        },
+      })
+      const originalHeaders = [...originalResponse.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', () => originalResponse)
+
+      const res = await app.request(path)
+      expect(res).toBe(originalResponse)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Original response')
+      expect([...res.headers]).toEqual(originalHeaders)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const body = '{"message":"Hono!"}'
+      const originalResponse = new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Upstream': 'original',
+        },
+      })
+      const originalHeaders = [...originalResponse.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => originalResponse)
+
+      const res = await app.request(path)
+      expect(res).toBe(originalResponse)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(originalHeaders)
+      expect(res.body).toBe(originalResponse.body)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const body = '{"message":"Hono!"}'
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Upstream': 'original',
+            },
+          })
+      )
+
+      const res = await app.request(path)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Upstream')).toBe('original')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
