+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Length': '18',
+        'Content-Type': 'application/json',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+
+  it('Should pass through JSON responses with unreadable bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Length': '0',
+        'Content-Type': 'application/json',
+        'X-Test': 'empty',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not JSON', 200, {
+        'Content-Length': '8',
+        'Content-Type': 'application/json',
+        'X-Test': 'invalid',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Length': '0',
+        'Content-Type': 'application/json',
+        'X-Test': 'no-content',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Length': '0',
+        'Content-Type': 'application/json',
+        'X-Test': 'not-modified',
+      })
+    )
+
+    for (const [path, status, body, marker] of [
+      ['/empty', 200, '', 'empty'],
+      ['/invalid', 200, 'not JSON', 'invalid'],
+      ['/no-content', 204, '', 'no-content'],
+      ['/not-modified', 304, '', 'not-modified'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Length')).toBe(path === '/invalid' ? '8' : '0')
+      expect(res.headers.get('X-Test')).toBe(marker)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should pass through JSON responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Length': '18',
+        'Content-Type': 'application/json',
+        'X-Test': 'read',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('18')
+    expect(res.headers.get('X-Test')).toBe('read')
+  })
+
