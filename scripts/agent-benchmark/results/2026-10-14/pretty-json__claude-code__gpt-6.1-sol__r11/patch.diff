+  describe.each([
+    { activation: 'query', options: undefined, url: '/?pretty' },
+    { activation: 'force', options: { force: true }, url: '/' },
+  ])('When prettification is enabled by $activation', ({ options, url }) => {
+    it.each([
+      { name: '204 response', status: 204, body: null, contentLength: '0' },
+      { name: '304 response', status: 304, body: null, contentLength: '123' },
+      { name: 'null body', status: 200, body: null, contentLength: '0' },
+      { name: 'empty body', status: 200, body: '', contentLength: '0' },
+      { name: 'invalid JSON', status: 502, body: 'not JSON', contentLength: '8' },
+    ])('Should preserve a $name unchanged', async ({ status, body, contentLength }) => {
+      const app = new Hono()
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': contentLength,
+        'X-Custom': 'original',
+      })
+      const response = new Response(body, { status, statusText: 'Original response', headers })
+      app.use('*', prettyJSON(options))
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Original response')
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(false)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response whose body was already read', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Custom': 'original',
+      })
+      let response: Response | undefined
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        response = c.res
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => new Response(body, { status: 202, headers }))
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length when prettifying a body', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            statusText: 'Created',
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Custom': 'original',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.statusText).toBe('Created')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Custom')).toBe('original')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
   it('Should not touch responses with non-JSON content-types', async () => {
