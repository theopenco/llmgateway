+  describe.each([
+    { mode: 'query parameter', options: {}, query: '?pretty' },
+    { mode: 'force option', options: { force: true }, query: '' },
+  ])('With $mode', ({ options, query }) => {
+    it.each([
+      { name: '204 response', status: 204, body: null },
+      { name: '304 response', status: 304, body: null },
+      { name: 'null body', status: 200, body: null },
+      { name: 'empty body', status: 200, body: '' },
+      { name: 'invalid JSON', status: 502, body: 'Bad Gateway' },
+      { name: 'truncated JSON', status: 200, body: '{"message":' },
+    ])('Should preserve a $name unchanged', async ({ status, body }) => {
+      const app = new Hono()
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body?.length ?? 0),
+        'X-Original': 'kept',
+      })
+      const original = new Response(body, { status, headers })
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(`/${query}`)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual([...headers])
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Original': 'kept',
+      })
+      let original: Response | undefined
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+        original = c.res
+      })
+      app.get('/', () => new Response(body, { status: 202, headers }))
+
+      const res = await app.request(`/${query}`)
+      expect(res).toBe(original)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length when prettifying JSON', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      app.use('*', prettyJSON(options))
+      app.get('/', () => {
+        return new Response(body, {
+          status: 201,
+          statusText: 'Created',
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': String(body.length),
+            'X-Original': 'kept',
+          },
+        })
+      })
+
+      const res = await app.request(`/${query}`)
+      expect(res.status).toBe(201)
+      expect(res.statusText).toBe('Created')
+      expect([...res.headers]).toEqual([
+        ['content-type', 'application/json'],
+        ['x-original', 'kept'],
+      ])
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
