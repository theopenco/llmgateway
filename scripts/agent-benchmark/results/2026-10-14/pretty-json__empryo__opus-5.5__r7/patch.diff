+
+describe('JSON pretty by Middleware - unparsable JSON bodies', () => {
+  const createApp = () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    return app
+  }
+
+  it('Should pass through 204 with JSON content-type and no body', async () => {
+    const app = createApp()
+    app.get('/', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    const res = await app.request('/')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through 304 with JSON content-type and no body', async () => {
+    const app = createApp()
+    app.get('/', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    const res = await app.request('/')
+    expect(res.status).toBe(304)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an empty body', async () => {
+    const app = createApp()
+    app.get('/', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through invalid JSON unchanged, keeping Content-Length', async () => {
+    const app = createApp()
+    app.get('/', () =>
+      new Response('not json {', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '10', 'X-Custom': 'a' },
+      })
+    )
+    const res = await app.request('/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('10')
+    expect(res.headers.get('X-Custom')).toBe('a')
+    expect(await res.text()).toBe('not json {')
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }, 201))
+    const res = await app.request('/')
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = createApp()
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
+
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
