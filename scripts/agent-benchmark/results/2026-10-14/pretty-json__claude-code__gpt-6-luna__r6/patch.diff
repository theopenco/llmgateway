+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'preserved',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'preserved',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'preserved',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'preserved',
+      })
+    )
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('preserved')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Test')).toBe('preserved')
+    expect(await emptyRes.text()).toBe('')
+
+    for (const [path, status] of [
+      ['/no-content', 204],
+      ['/not-modified', 304],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(res.headers.get('X-Test')).toBe('preserved')
+      expect(await res.text()).toBe('')
+    }
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 202, {
+        'Content-Type': 'application/json',
+        'X-Test': 'preserved',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(202)
+    expect(res.headers.get('X-Test')).toBe('preserved')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
