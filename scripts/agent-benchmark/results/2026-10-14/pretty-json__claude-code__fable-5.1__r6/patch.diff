--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,88 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty by Middleware with unparsable bodies', () => {
+  const pass = async (
+    res: Response,
+    status: number,
+    body: string | null,
+    contentLength: string | null
+  ) => {
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe(contentLength)
+    expect(res.body ? await res.text() : null).toBe(body)
+  }
+
+  it('Should pass through responses without a body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) =>
+      c.body(null, 304, { 'Content-Type': 'application/json', 'Content-Length': '17' })
+    )
+
+    await pass(await app.request('http://localhost/no-content'), 204, null, null)
+    await pass(await app.request('http://localhost/not-modified'), 304, null, '17')
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+
+    await pass(await app.request('http://localhost/?pretty'), 200, '', '0')
+  })
+
+  it('Should pass through a body that is not valid JSON unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/', (c) =>
+      c.body('<html>upstream error</html>', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '27',
+      })
+    )
+
+    await pass(
+      await app.request('http://localhost/?pretty'),
+      502,
+      '<html>upstream error</html>',
+      '27'
+    )
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should drop the original Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
