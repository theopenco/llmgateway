+describe('EventProcessor.createRequest with empty query parameters', () => {
+  it.each(['API Gateway REST v1', 'ALB'])(
+    'Should preserve empty strings and omit undefined values for %s',
+    (eventType) => {
+      const queryStringParameters = { empty: '', present: '0', omitted: undefined }
+      const event: LambdaEvent =
+        eventType === 'ALB'
+          ? {
+              httpMethod: 'GET',
+              path: '/my/path',
+              headers: { host: 'example.com' },
+              body: null,
+              isBase64Encoded: false,
+              queryStringParameters,
+              requestContext: {
+                elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:targetgroup/test' },
+              },
+            }
+          : { ...baseV1Event, queryStringParameters }
+
+      const request = getProcessor(event).createRequest(event)
+      const host = eventType === 'ALB' ? 'example.com' : 'id.execute-api.us-east-1.amazonaws.com'
+
+      expect(request.url).toEqual(`https://${host}/my/path?empty=&present=0`)
+    }
+  )
+})
