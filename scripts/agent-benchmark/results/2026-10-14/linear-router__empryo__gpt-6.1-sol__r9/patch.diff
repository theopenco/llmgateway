+
+describe('LinearRouter named parameters', () => {
+  it.each(['/u//posts', '/u//posts/'])('does not match an empty middle segment: %s', (path) => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'posts')
+
+    expect(router.match('GET', path)).toEqual([[]])
+  })
+
+  it.each(['/u/123/posts', '/u/123/posts/'])('matches a non-empty middle segment: %s', (path) => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'posts')
+
+    expect(router.match('GET', path)).toEqual([[['posts', { id: '123' }]]])
+  })
+})
