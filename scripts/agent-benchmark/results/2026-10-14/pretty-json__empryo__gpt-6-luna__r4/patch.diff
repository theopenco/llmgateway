diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..1a84a4d 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,42 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('prettyJSON passthrough', () => {
+  it('preserves invalid and empty JSON responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0', 'X-Test': 'preserved' }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8', 'X-Test': 'preserved' }))
+    app.get('/204', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0', 'X-Test': 'preserved' }))
+    app.get('/304', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json', 'Content-Length': '0', 'X-Test': 'preserved' }))
+    for (const [path, status, body, length] of [['/empty', 200, '', '0'], ['/invalid', 200, 'not json', '8'], ['/204', 204, '', '0'], ['/304', 304, '', '0']] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(length)
+      expect(res.headers.get('X-Test')).toBe('preserved')
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('does not prettify a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => { await next(); await c.res.clone().text() })
+    app.get('/', (c) => c.newResponse('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8' }))
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('removes Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"value":1}', 200, { 'Content-Type': 'application/json', 'Content-Length': '11' }))
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe('{\n  \"value\": 1\n}')
+  })
+})
+
