diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..ac2d210 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,65 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+
+describe('prettyJSON with unparseable JSON responses', () => {
+  it.each([
+    ['204', 204, null],
+    ['304', 304, null],
+    ['empty', 200, ''],
+    ['invalid JSON', 200, 'not JSON'],
+  ] as const)('passes through %s responses', async (_label, status, body) => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(body, status, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'preserved',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Test')).toBe('preserved')
+    expect(await res.text()).toBe(body ?? '')
+  })
+
+  it('removes Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{\n  "message": "Hono!"\n}`)
+  })
+
+  it('handles a response body read and rewrapped by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      c.res = new Response(await c.res.text(), c.res)
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{\n  "message": "Hono!"\n}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+})
+
