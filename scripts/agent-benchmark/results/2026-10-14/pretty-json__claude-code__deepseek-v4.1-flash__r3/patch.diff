+  it('Should remove the Content-Length header when a body is prettified', async () => {
+    const body = '{"message":"Hono!"}'
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should pass through unchanged when the JSON body is empty', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+
+    const res = await app.request('http://localhost/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through 204 responses with a JSON content-type', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      return c.body(null, 204, { 'Content-Type': 'application/json' })
+    })
+
+    const res = await app.request('http://localhost/no-content')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through non-JSON bodies with a JSON content-type', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/broken', (c) =>
+      c.newResponse('not json', 200, { 'Content-Type': 'application/json' })
+    )
+
+    const res = await app.request('http://localhost/broken')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should not throw when the body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
