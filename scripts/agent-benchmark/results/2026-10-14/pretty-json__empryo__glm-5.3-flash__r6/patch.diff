@@ -120,3 +120,67 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('Pretty JSON Middleware - unparseable JSON bodies pass through', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+  app.get('/304', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+  app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+  app.get('/invalid', (c) => c.body('not json', 200, { 'Content-Type': 'application/json' }))
+  app.get('/consumed', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+  it('Should pass through a 204 response with JSON content-type and no body', async () => {
+    const res = await app.request('http://localhost/204')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a 304 response with JSON content-type and no body', async () => {
+    const res = await app.request('http://localhost/304')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an empty body with JSON content-type', async () => {
+    const res = await app.request('http://localhost/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a body that is not valid JSON', async () => {
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should pass through a response whose body was already consumed', async () => {
+    const res = await app.request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should remove Content-Length when a body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
