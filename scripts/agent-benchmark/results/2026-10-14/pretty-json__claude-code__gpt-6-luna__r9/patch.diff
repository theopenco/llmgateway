diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..db798e7 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,88 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON content-types with empty or invalid bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    )
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    )
+
+    const emptyRes = await app.request('/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const noContentRes = await app.request('/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Length')).toBe('0')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Length')).toBe('8')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.json({ message: 'Hono!' }, 200, {
+        'Content-Length': '17',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should pass through a response whose body was read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('8')
+  })
 })
