+  it('Should remove Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should pass through JSON responses with an empty body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.body(null, 200, { 'Content-Type': 'application/json' })
+    )
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(await noContentRes.text()).toBe('')
+  })
+
+  it('Should pass through JSON responses whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/broken', (c) =>
+      c.body('not json at all', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '15',
+      })
+    )
+
+    const res = await app.request('http://localhost/broken')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('15')
+    expect(await res.text()).toBe('not json at all')
+  })
+
+  it('Should pass through when the body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/read', async (c) => {
+      const res = c.json({ message: 'Hono!' })
+      await res.text()
+      return res
+    })
+
+    const res = await app.request('http://localhost/read')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
