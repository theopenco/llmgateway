+
+describe('JSON pretty by Middleware - unparsable JSON bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', () => {
+    return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+  })
+  app.get('/not-modified', () => {
+    return new Response(null, { status: 304, headers: { 'Content-Type': 'application/json' } })
+  })
+  app.get('/empty', () => {
+    return new Response('', {
+      status: 200,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+    })
+  })
+  app.get('/invalid', () => {
+    return new Response('not json', {
+      status: 502,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+    })
+  })
+  app.get(
+    '/consumed',
+    async (c, next) => {
+      await next()
+      await c.res.text()
+    },
+    (c) => c.json({ message: 'Hono!' })
+  )
+  app.get('/valid', () => {
+    return new Response('{"message":"Hono!"}', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '19', 'X-Custom': 'yes' },
+    })
+  })
+
+  it.each([
+    ['/no-content', 204],
+    ['/not-modified', 304],
+  ])('Should pass through %s unchanged', async (path, status) => {
+    const res = await app.request(path)
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const res = await app.request('/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body unchanged', async () => {
+    const res = await app.request('/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should not throw when the body was already consumed', async () => {
+    const res = await app.request('/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const res = await app.request('/valid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('yes')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
+
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
