+  describe.each([false, true])('Response preservation with force: %s', (force) => {
+    const url = force ? 'http://localhost/' : 'http://localhost/?pretty'
+
+    it.each([
+      { name: '204 response', status: 204, body: null },
+      { name: '304 response', status: 304, body: null },
+      { name: 'null body', status: 200, body: null },
+      { name: 'empty body', status: 200, body: '' },
+      { name: 'whitespace body', status: 200, body: ' \n' },
+      { name: 'invalid JSON body', status: 502, body: '{invalid json' },
+    ])('Should not change a $name', async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      const response = new Response(body, {
+        status,
+        statusText: 'Unchanged',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Unchanged')
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(false)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should not change a response whose body was already read', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe('{"message":"Hono!"}')
+      })
+      const response = new Response('{"message":"Hono!"}', {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.headers.get('Content-Length')).toBe('19')
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get('/', (c) =>
+        c.body('{"message":"Hono!"}', 201, {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Custom': 'preserved',
+        })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
