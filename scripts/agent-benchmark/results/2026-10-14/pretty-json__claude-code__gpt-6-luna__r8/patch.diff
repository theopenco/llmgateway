+  it('Should pass through JSON responses with bodies that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Original': 'unchanged',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Original': 'unchanged',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Original': 'unchanged',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not JSON', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Original': 'unchanged',
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not JSON', '8'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Original')).toBe('unchanged')
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should skip JSON responses whose bodies were already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+        'X-Original': 'unchanged',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('18')
+    expect(res.headers.get('X-Original')).toBe('unchanged')
+  })
+
+  it('Should remove Content-Length when pretty-printing JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+        'X-Original': 'unchanged',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Original')).toBe('unchanged')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
