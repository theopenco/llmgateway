     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
+      let obj: unknown
+      try {
+        // Parse a clone so the original response stays intact when the body is
+        // not valid JSON (empty body, null-body status, proxied payload) or has
+        // already been consumed by another middleware.
+        obj = await c.res.clone().json()
+      } catch {
+        return
+      }
+      // The Context.res setter re-applies the previous response's headers, so
+      // drop the stale Content-Length from the original before replacing it.
+      c.res.headers.delete('Content-Length')
       c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
     }
   }
