diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..e5d908d 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,88 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Should pass through responses whose body cannot be parsed as JSON', () => {
+    it('Should pass through a 204 with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a 304 with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an empty body unchanged', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a body that is not valid JSON unchanged', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) =>
+        c.body('<html>not json</html>', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '20',
+          'X-Custom': 'kept',
+        })
+      )
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('20')
+      expect(res.headers.get('X-Custom')).toBe('kept')
+      expect(await res.text()).toBe('<html>not json</html>')
+    })
+
+    it('Should pass through a body that was already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+    })
+  })
+
+  it('Should remove the original Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.get('Content-Length')).not.toBe('18')
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..bdc9a92 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,14 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        const body = await c.res.clone().text()
+        const obj = JSON.parse(body)
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // Not valid JSON (empty, truncated, or already consumed): pass through.
+      }
     }
   }
 }
