+describe('EventProcessor.createRequest with empty query parameters', () => {
+  it.each<[string, LambdaEvent]>([
+    ['API Gateway v1', baseV1Event],
+    [
+      'ALB',
+      {
+        httpMethod: 'GET',
+        path: '/my/path',
+        headers: { host: 'example.com' },
+        body: null,
+        isBase64Encoded: false,
+        requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+      },
+    ],
+  ])('Should preserve empty query values and omit undefined values for %s', (_name, baseEvent) => {
+    const event: LambdaEvent = {
+      ...baseEvent,
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+    }
+
+    const request = getProcessor(event).createRequest(event)
+    const url = new URL(request.url)
+
+    expect(url.pathname + url.search).toEqual('/my/path?empty=&present=0')
+    expect(url.searchParams.get('empty')).toBe('')
+    expect(url.searchParams.has('omitted')).toBe(false)
+  })
+})
