+  describe.each([
+    { name: 'query parameter', options: undefined, path: '/?pretty' },
+    { name: 'force option', options: { force: true }, path: '/' },
+  ])('With $name', ({ options, path }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 502, body: '<html>Bad Gateway</html>' },
+    ])('Should preserve a non-JSON body ($status, $body)', async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const response = new Response(body, {
+        status,
+        statusText: 'Upstream response',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(path)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Upstream response')
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response whose body was already read', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      const body = '{"message":"Hono!"}'
+      const response = new Response(body, {
+        status: 202,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Upstream': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(path)
+      expect(res).toBe(response)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const body = '{"message":"Hono!"}'
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 202,
+            statusText: 'Accepted',
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Upstream': 'preserved',
+            },
+          })
+      )
+
+      const res = await app.request(path)
+      expect(res.status).toBe(202)
+      expect(res.statusText).toBe('Accepted')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Upstream')).toBe('preserved')
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
