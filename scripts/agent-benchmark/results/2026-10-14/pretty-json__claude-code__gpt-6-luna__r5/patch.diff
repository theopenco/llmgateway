diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..99815b0 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,104 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Response': 'empty',
+        },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not json', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Response': 'invalid',
+        },
+      })
+    )
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Response': 'no-content',
+        },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Response': 'not-modified',
+        },
+      })
+    )
+
+    for (const [path, status, body, length, responseHeader] of [
+      ['/empty', 200, '', '0', 'empty'],
+      ['/invalid', 200, 'not json', '8', 'invalid'],
+      ['/no-content', 204, '', '8', 'no-content'],
+      ['/not-modified', 304, '', '8', 'not-modified'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(length)
+      expect(res.headers.get('X-Response')).toBe(responseHeader)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should pass through responses whose body was read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Response': 'read',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('19')
+    expect(res.headers.get('X-Response')).toBe('read')
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
