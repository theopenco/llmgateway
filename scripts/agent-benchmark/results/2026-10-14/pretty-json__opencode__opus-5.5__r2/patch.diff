diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..ef44cb9 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,90 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Responses with a JSON content-type but no parseable JSON body', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/no-content', () => {
+      return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/not-modified', () => {
+      return new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json', ETag: '"abc"' },
+      })
+    })
+    app.get('/empty', () => {
+      return new Response('', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+      })
+    })
+    app.get('/invalid', () => {
+      return new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8', 'X-Upstream': '1' },
+      })
+    })
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' })
+    )
+
+    it.each(['/no-content', '/not-modified'])('Should pass through %s unchanged', async (path) => {
+      const res = await app.request(`http://localhost${path}?pretty`)
+      expect(res.status).toBe(path === '/no-content' ? 204 : 304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an empty body unchanged', async () => {
+      const res = await app.request('http://localhost/empty?pretty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an invalid JSON body unchanged', async () => {
+      const res = await app.request('http://localhost/invalid?pretty')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(res.headers.get('X-Upstream')).toBe('1')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should not fail when the body was already consumed', async () => {
+      const res = await app.request('http://localhost/consumed?pretty')
+      expect(res.status).toBe(200)
+    })
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Custom': 'yes',
+        },
+      })
+    })
+
+    const res = await app.request('http://localhost/?pretty')
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('yes')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..64c9aa8 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,30 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+    const res = c.res
+    // Nothing to prettify (e.g. 204/304, or the body was already consumed)
+    if (!res.body || res.bodyUsed) {
+      return
+    }
+    let obj: unknown
+    try {
+      // Read from a clone so the original body stays intact if parsing fails
+      obj = JSON.parse(await res.clone().text())
+    } catch {
+      return
+    }
+    const headers = new Headers(res.headers)
+    headers.delete('Content-Length')
+    const prettyRes = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+      status: res.status,
+      statusText: res.statusText,
+      headers,
+    })
+    // Reset first so the `c.res` setter does not merge the stale Content-Length back in
+    c.res = undefined
+    c.res = prettyRes
   }
 }
