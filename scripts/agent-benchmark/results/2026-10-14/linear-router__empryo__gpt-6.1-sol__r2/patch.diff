+describe('Empty route parameters', () => {
+  it.each(['/u//posts', '/u//posts/'])('does not match %s', (path) => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'handler')
+    expect(router.match('GET', path)).toEqual([[]])
+  })
+
+  it('matches a non-empty parameter', () => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'handler')
+    expect(router.match('GET', '/u/123/posts')).toEqual([[['handler', { id: '123' }]]])
+  })
+})
