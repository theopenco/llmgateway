diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..02d5044 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,85 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses with unparseable bodies unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () => {
+      return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/not-modified', () => {
+      return new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json', ETag: '"abc"' },
+      })
+    })
+    app.get('/empty', () => {
+      return new Response('', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+      })
+    })
+    app.get('/invalid', () => {
+      return new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    })
+
+    const noContent = await app.request('http://localhost/no-content')
+    expect(noContent.status).toBe(204)
+    expect(noContent.headers.get('Content-Type')).toBe('application/json')
+    expect(noContent.body).toBeNull()
+
+    const notModified = await app.request('http://localhost/not-modified')
+    expect(notModified.status).toBe(304)
+    expect(notModified.headers.get('ETag')).toBe('"abc"')
+    expect(notModified.body).toBeNull()
+
+    const empty = await app.request('http://localhost/empty')
+    expect(empty.status).toBe(200)
+    expect(empty.headers.get('Content-Length')).toBe('0')
+    expect(await empty.text()).toBe('')
+
+    const invalid = await app.request('http://localhost/invalid')
+    expect(invalid.status).toBe(502)
+    expect(invalid.headers.get('Content-Type')).toBe('application/json')
+    expect(invalid.headers.get('Content-Length')).toBe('8')
+    expect(await invalid.text()).toBe('not json')
+  })
+
+  it('Should pass through JSON responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }, 201))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': String(body.length) },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
