+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'unchanged',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'unchanged',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'unchanged',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Test': 'unchanged',
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Test')).toBe('unchanged')
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should pass through a JSON response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('18')
+    expect(await res.text()).toBe('{"message":"Hono!"}')
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
