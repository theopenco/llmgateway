index ed8404b..49b33c0 100644
--- a/src/router/linear-router/router.test.ts
+++ b/src/router/linear-router/router.test.ts
@@ -77,4 +77,38 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/u/:id', 'GET /u/:id')
+    })
+
+    it('GET /u//posts', () => {
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//', () => {
+      const [res] = router.match('GET', '/u//')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/1/posts still matches', () => {
+      const [res] = router.match('GET', '/u/1/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]).toEqual({ id: '1' })
+    })
+
+    it('GET /u/1 still matches', () => {
+      const [res] = router.match('GET', '/u/1')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id')
+      expect(res[0][1]).toEqual({ id: '1' })
+    })
+  })
 })
