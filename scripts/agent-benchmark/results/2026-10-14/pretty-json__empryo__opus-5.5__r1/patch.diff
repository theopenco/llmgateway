 })
+
+describe('JSON pretty by Middleware - non-parsable bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', () => {
+    return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+  })
+  app.get('/not-modified', () => {
+    return new Response(null, {
+      status: 304,
+      headers: { 'Content-Type': 'application/json', ETag: '"abc"' },
+    })
+  })
+  app.get('/empty', () => {
+    return new Response('', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+    })
+  })
+  app.get('/invalid', () => {
+    return new Response('not json', {
+      status: 502,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+    })
+  })
+  app.get('/consumed', async () => {
+    const res = new Response('{"a":1}', { headers: { 'Content-Type': 'application/json' } })
+    await res.text()
+    return res
+  })
+  app.get('/valid', () => {
+    return new Response('{"a":1}', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '7' },
+    })
+  })
+
+  it('Should pass through 204 responses unchanged', async () => {
+    const res = await app.request('/no-content')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through 304 responses unchanged', async () => {
+    const res = await app.request('/not-modified')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('ETag')).toBe('"abc"')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through empty bodies unchanged', async () => {
+    const res = await app.request('/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through invalid JSON bodies unchanged', async () => {
+    const res = await app.request('/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should pass through already consumed bodies', async () => {
+    const res = await app.request('/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should drop the original Content-Length when prettifying', async () => {
+    const res = await app.request('/valid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe('{\n  "a": 1\n}')
+  })
+})
+
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..ff7850e 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,21 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      if (!res.body || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        obj = JSON.parse(await res.clone().text())
+      } catch {
+        return
+      }
+      const prettyRes = new Response(JSON.stringify(obj, null, options?.space ?? 2), res)
+      prettyRes.headers.delete('Content-Length')
+      // Reset first so the `c.res` setter does not copy the stale Content-Length back
+      c.res = undefined
+      c.res = prettyRes
     }
   }
 }
