diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..c5650df 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,66 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses whose body cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () => {
+      return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/not-modified', () => {
+      return new Response(null, { status: 304, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', () => {
+      return new Response('not json', {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    })
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' })
+    )
+
+    for (const [path, status] of [
+      ['/no-content', 204],
+      ['/not-modified', 304],
+      ['/empty', 200],
+    ] as const) {
+      const res = await app.request(path)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    }
+
+    const invalidRes = await app.request('/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const consumedRes = await app.request('/consumed')
+    expect(consumedRes.status).toBe(200)
+    expect(consumedRes.bodyUsed).toBe(true)
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    })
+
+    const res = await app.request('/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
