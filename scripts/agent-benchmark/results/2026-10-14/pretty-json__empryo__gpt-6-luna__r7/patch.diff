index 70b44b6..4865aa0 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,88 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty middleware pass-through', () => {
+  it('preserves responses whose bodies are not parseable as JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Keep': 'empty',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Keep': 'invalid',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Keep': '204',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Keep': '304',
+      })
+    )
+
+    for (const [path, status, body, marker, length] of [
+      ['/empty', 200, '', 'empty', '0'],
+      ['/invalid', 200, 'not json', 'invalid', '8'],
+      ['/no-content', 204, '', '204', '0'],
+      ['/not-modified', 304, '', '304', '0'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(length)
+      expect(res.headers.get('X-Keep')).toBe(marker)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('does not retain Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"ok":true}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '11',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "ok": true
+}`)
+  })
+
+  it('does not throw when the response body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"ok":true}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '11',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('11')
+  })
+})
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
