@@ -2,6 +2,53 @@ import { Hono } from '../../hono'
 import { prettyJSON } from '.'
 
 describe('JSON pretty by Middleware', () => {
+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse(null, 204, { 'Content-Type': 'application/json', 'X-Test': 'same' })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, { 'Content-Type': 'application/json', 'X-Test': 'same' })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'same',
+      })
+    )
+    for (const [path, status, body, length] of [
+      ['/empty', 204, '', null],
+      ['/not-modified', 304, '', null],
+      ['/invalid', 200, 'not json', '8'],
+    ] as const) {
+      const res = await app.request(path)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Test')).toBe('same')
+      expect(res.headers.get('Content-Length')).toBe(length)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should remove content length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
