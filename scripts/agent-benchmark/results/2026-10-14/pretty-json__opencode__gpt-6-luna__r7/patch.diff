   it('Should return pretty JSON output with 4 spaces', async () => {
@@ -119,4 +120,71 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Proxy': 'upstream',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '12',
+      })
+    )
+
+    const emptyRes = await app.request('/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Proxy')).toBe('upstream')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const noContentRes = await app.request('/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Length')).toBe('0')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Length')).toBe('12')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through JSON responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    let readBody = ''
+    app.use('*', async (c, next) => {
+      await next()
+      readBody = await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('18')
+    expect(readBody).toBe('{"message":"Hono!"}')
+  })
 })
