diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..53fe53b 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,61 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': String(body.length) },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Should pass through JSON responses whose body cannot be prettified', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) =>
+      c.body(null, 304, { 'Content-Type': 'application/json', 'Content-Length': '42' })
+    )
+    app.get('/empty', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+    app.get('/invalid', (c) =>
+      c.body('not json', 502, { 'Content-Type': 'application/json', 'Content-Length': '8' })
+    )
+    app.use('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+    it.each([
+      ['/204', 204, null, ''],
+      ['/304', 304, '42', ''],
+      ['/empty', 200, '0', ''],
+      ['/invalid', 502, '8', 'not json'],
+    ])('%s', async (path, status, contentLength, body) => {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(await res.text()).toBe(body)
+    })
+
+    it('/consumed', async () => {
+      const res = await app.request('http://localhost/consumed')
+      expect(res.status).toBe(200)
+      expect(res.bodyUsed).toBe(true)
+    })
+  })
 })
