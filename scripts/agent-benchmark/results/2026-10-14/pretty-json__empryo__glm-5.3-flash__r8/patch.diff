diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..6a284c4 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -118,5 +118,70 @@ describe('JSON pretty by Middleware', () => {
 
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
+})
+
+it('Should pass through responses with a JSON content-type but no body', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+  app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+
+  const noContentRes = await app.request('http://localhost/no-content')
+  expect(noContentRes.status).toBe(204)
+  expect(await noContentRes.text()).toBe('')
+
+  const notModifiedRes = await app.request('http://localhost/not-modified')
+  expect(notModifiedRes.status).toBe(304)
+  expect(await notModifiedRes.text()).toBe('')
+})
+
+it('Should pass through responses whose body is not valid JSON', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/proxy', (c) =>
+    c.body('not valid json', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '14',
+    })
+  )
+
+  const res = await app.request('http://localhost/proxy')
+  expect(res.status).toBe(200)
+  expect(res.headers.get('Content-Length')).toBe('14')
+  expect(await res.text()).toBe('not valid json')
+})
+
+it('Should pass through responses whose body was already consumed', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/consumed', async (c) => {
+    const res = new Response('{"message":"Hono!"}', {
+      headers: { 'Content-Type': 'application/json' },
+    })
+    await res.text()
+    return res
+  })
+
+  const res = await app.request('http://localhost/consumed')
+  expect(res.status).toBe(200)
+  await expect(res.text()).rejects.toThrow()
+})
+
+it('Should remove Content-Length when prettifying the body', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/', (c) => {
+    const body = JSON.stringify({ message: 'Hono!' })
+    return c.newResponse(body, 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': String(body.length),
+    })
   })
+
+  const res = await app.request('http://localhost/')
+  expect(res.headers.get('Content-Length')).toBeNull()
+  expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+})
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
