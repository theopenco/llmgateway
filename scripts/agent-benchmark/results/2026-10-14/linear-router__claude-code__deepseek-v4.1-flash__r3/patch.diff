diff --git a/src/router/linear-router/router.test.ts b/src/router/linear-router/router.test.ts
index ed8404b..d937997 100644
--- a/src/router/linear-router/router.test.ts
+++ b/src/router/linear-router/router.test.ts
@@ -77,4 +77,35 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty segment', () => {
+    const newRouter = () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/:x/:y', 'GET /:x/:y')
+      return router
+    }
+
+    it('GET /u//posts', () => {
+      const [res] = newRouter().match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/posts', () => {
+      const [res] = newRouter().match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+
+    it('GET /a//', () => {
+      const [res] = newRouter().match('GET', '/a//')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /a/b', () => {
+      const [res] = newRouter().match('GET', '/a/b')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ x: 'a', y: 'b' })
+    })
+  })
 })
