+  it('Should pass through JSON responses that cannot be prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse(null, 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Test': 'preserved',
+    }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Test': 'preserved',
+    }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Test': 'preserved',
+    }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Test': 'preserved',
+    }))
+
+    for (const [path, status, body, contentLength] of [
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+    ] as const) {
+      const res = await app.request('http://localhost' + path)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('X-Test')).toBe('preserved')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should leave responses alone when another middleware reads the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (_, next) => {
+      await next()
+      await _.res.text()
+    })
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'X-Test': 'preserved',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Test')).toBe('preserved')
+  })
+
+  it('Should remove Content-Length from prettified responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '18',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe('{\n  \"message\": \"Hono!\"\n}')
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+
