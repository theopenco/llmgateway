diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..e47f25e 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,88 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Responses that cannot be parsed as JSON', () => {
+    it('Should pass through a JSON content-type response without a body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/no-content')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a JSON content-type response with an empty body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/empty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a JSON content-type response with an unparsable body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/invalid', (c) => c.body('not json', 200, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/invalid')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should pass through when the body has already been read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+    })
+
+    it('Should preserve the Content-Length of an untouched response', async () => {
+      const body = 'not json'
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/invalid', (c) =>
+        c.body(body, 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+        })
+      )
+
+      const res = await app.request('http://localhost/invalid')
+      expect(res.headers.get('Content-Length')).toBe(String(body.length))
+      expect(await res.text()).toBe(body)
+    })
+  })
+
+  it('Should remove the original Content-Length when the body is prettified', async () => {
+    const body = JSON.stringify({ message: 'Hono!' })
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
