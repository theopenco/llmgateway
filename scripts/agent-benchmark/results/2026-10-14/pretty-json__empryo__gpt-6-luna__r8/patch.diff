diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..f4c713d 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,61 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+
+describe('prettyJSON pass-through', () => {
+  it.each([
+    ['empty body', 200, ''],
+    ['invalid JSON', 200, 'not json'],
+  ])('passes through a %s response', async (_label, status, body) => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(body, status as 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Original': 'yes',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Original')).toBe('yes')
+    expect(await res.text()).toBe(body)
+  })
+
+  it('passes through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'X-Original': 'yes',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Original')).toBe('yes')
+  })
+
+  it('removes Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{\n  \"message\": \"Hono!\"\n}`)
+  })
+})
