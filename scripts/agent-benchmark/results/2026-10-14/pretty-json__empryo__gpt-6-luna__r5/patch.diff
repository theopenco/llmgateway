+  it('Should pass through responses that cannot be parsed as JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8' })
+    )
+    app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, { 'Content-Type': 'application/json' })
+    )
+    app.get('/read', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/read', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/no-content', 204, '', null],
+      ['/not-modified', 304, '', null],
+      ['/read', 200, '{"message":"Hono!"}', '18'],
+    ] as const) {
+      const res = await app.request(path)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      if (path !== '/read') {
+        expect(await res.text()).toBe(body)
+      }
+    }
+  })
+
+  it('Should remove Content-Length from prettified responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+  })
+
