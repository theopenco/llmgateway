diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..6fdf4dc 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,76 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty with unparsable JSON bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', (c) => {
+    return c.body(null, 204, { 'Content-Type': 'application/json' })
+  })
+  app.get('/not-modified', (c) => {
+    return c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+  })
+  app.get('/empty', (c) => {
+    return c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+  })
+  app.get('/invalid', () => {
+    return new Response('not json {', {
+      status: 502,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '10', 'X-Upstream': '1' },
+    })
+  })
+  app.use('/consumed', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+  app.get('/with-length', (c) => {
+    const body = JSON.stringify({ message: 'Hono!' })
+    return c.body(body, 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': String(body.length),
+    })
+  })
+
+  it.each([
+    ['/no-content', 204],
+    ['/not-modified', 304],
+  ])('Should pass through %s unchanged', async (path, status) => {
+    const res = await app.request(path)
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const res = await app.request('/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body unchanged', async () => {
+    const res = await app.request('/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('10')
+    expect(res.headers.get('X-Upstream')).toBe('1')
+    expect(await res.text()).toBe('not json {')
+  })
+
+  it('Should not fail when the body was already read', async () => {
+    const res = await app.request('/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const res = await app.request('/with-length')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
+
