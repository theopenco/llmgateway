diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..13d08f9 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,70 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+
+it('passes through JSON responses that cannot be prettified', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/empty', (c) => c.newResponse('', 200, {
+    'Content-Type': 'application/json',
+    'Content-Length': '0',
+  }))
+  app.get('/invalid', (c) => c.newResponse('not json', 200, {
+    'Content-Type': 'application/json',
+    'Content-Length': '8',
+  }))
+  app.get('/no-content', (c) => c.newResponse(null, 204, {
+    'Content-Type': 'application/json',
+  }))
+  app.get('/not-modified', (c) => c.newResponse(null, 304, {
+    'Content-Type': 'application/json',
+  }))
+
+  for (const [path, status, contentLength, body] of [
+    ['/empty', 200, '0', ''],
+    ['/invalid', 200, '8', 'not json'],
+    ['/no-content', 204, null, ''],
+    ['/not-modified', 304, null, ''],
+  ] as const) {
+    const res = await app.request(path)
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe(contentLength)
+    expect(await res.text()).toBe(body)
+  }
+})
+
+it('passes through responses whose body was already read', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.use('*', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/', (c) => c.newResponse('not json', 200, {
+    'Content-Type': 'application/json',
+    'Content-Length': '8',
+  }))
+
+  const res = await app.request('/')
+  expect(res.status).toBe(200)
+  expect(res.headers.get('Content-Type')).toBe('application/json')
+  expect(res.headers.get('Content-Length')).toBe('8')
+})
+
+it('removes Content-Length from prettified JSON responses', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+    'Content-Type': 'application/json',
+    'Content-Length': '18',
+  }))
+
+  const res = await app.request('/')
+  expect(res.headers.has('Content-Length')).toBe(false)
+  expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+})
+
