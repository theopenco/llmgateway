diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..6df9480 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -2,6 +2,77 @@ import { Hono } from '../../hono'
 import { prettyJSON } from '.'
 
 describe('JSON pretty by Middleware', () => {
+  describe.each([false, true])('with force: %s', (force) => {
+    const url = force ? 'http://localhost/' : 'http://localhost/?pretty'
+
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: ' ' },
+      { status: 502, body: 'upstream error' },
+    ])('Should preserve unparseable JSON responses: %j', async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      const response = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'original',
+        },
+      })
+      const headers = Array.from(response.headers.entries())
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect(Array.from(res.headers.entries())).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      let originalResponse: Response | undefined
+      app.use('*', async (c, next) => {
+        await next()
+        originalResponse = c.res
+        expect(await c.res.text()).toBe('{"message":"Hono!"}')
+      })
+      app.get('/', (c) => {
+        return c.json({ message: 'Hono!' }, 202, { 'Content-Length': '19' })
+      })
+
+      const res = await app.request(url)
+      expect(res).toBe(originalResponse)
+      expect(res.status).toBe(202)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('19')
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get('/', (c) => {
+        return c.json({ message: 'Hono!' }, 202, {
+          'Content-Length': '19',
+          'X-Upstream': 'original',
+        })
+      })
+
+      const res = await app.request(url)
+      expect(res.status).toBe(202)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Upstream')).toBe('original')
+      expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+    })
+  })
+
   it('Should return pretty JSON output', async () => {
     const app = new Hono()
     app.use('*', prettyJSON())
