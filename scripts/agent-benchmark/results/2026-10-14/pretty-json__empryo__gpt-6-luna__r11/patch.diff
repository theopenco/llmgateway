+      const contentType = response.headers.get('Content-Type')
+      if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+        return
+      }
+      if (response.bodyUsed && responseClone) {
+        c.res = responseClone
+        response = c.res
+      }
+      let obj: unknown
+      try {
+        obj = await response.clone().json()
+      } catch {
+        return
+      }
+      const headers = new Headers(response.headers)
+      headers.delete('Content-Length')
+      c.res.headers.delete('Content-Length')
+      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: response.status,
+        statusText: response.statusText,
+        headers,
+      })
+    } finally {
+      Reflect.deleteProperty(c, 'res')
     }
   }
 }
