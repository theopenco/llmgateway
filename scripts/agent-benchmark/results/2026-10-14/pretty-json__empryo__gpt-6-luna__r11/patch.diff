+    const responseDescriptor = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(c), 'res')!
+    let responseClone: Response | undefined
+    Object.defineProperty(c, 'res', {
+      configurable: true,
+      get: () => responseDescriptor.get!.call(c),
+      set: (response: Response | undefined) => {
+        if (response) {
+          try {
+            responseClone = response.clone()
+          } catch {}
+        }
+        responseDescriptor.set!.call(c, response)
+      },
+    })
+    try {
+      await next()
