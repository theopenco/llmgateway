diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..ca2a41e 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,59 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('prettyJSON with non-JSON response bodies', () => {
+  it.each([
+    ['204 response', 204, null],
+    ['304 response', 304, null],
+    ['empty body', 200, ''],
+    ['invalid JSON body', 200, 'not JSON'],
+  ] as const)('passes through %s unchanged', async (_name, status, body) => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse(body, status, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Test': 'preserved',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Test')).toBe('preserved')
+    expect(await res.text()).toBe(body ?? '')
+  })
+
+  it('passes through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.newResponse('not JSON', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not JSON')
+  })
+
+  it('removes Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"key":1}', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '9' },
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "key": 1
+}`)
+  })
+})
+
