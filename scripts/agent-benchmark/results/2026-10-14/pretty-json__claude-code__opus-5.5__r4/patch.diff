diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..aa51d84 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,69 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON content-type responses whose body cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      return c.body(null, 204, { 'Content-Type': 'application/json' })
+    })
+    app.get('/not-modified', (c) => {
+      return c.body(null, 304, { 'Content-Type': 'application/json' })
+    })
+    app.get('/empty', (c) => {
+      return c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    })
+    app.get('/invalid', (c) => {
+      return c.body('not json', 502, { 'Content-Type': 'application/json', 'Content-Length': '8' })
+    })
+    app.use('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+    const noContent = await app.request('/no-content')
+    expect(noContent.status).toBe(204)
+    expect(noContent.headers.get('Content-Type')).toBe('application/json')
+    expect(noContent.body).toBeNull()
+
+    const notModified = await app.request('/not-modified')
+    expect(notModified.status).toBe(304)
+    expect(notModified.headers.get('Content-Type')).toBe('application/json')
+    expect(notModified.body).toBeNull()
+
+    const empty = await app.request('/empty')
+    expect(empty.status).toBe(200)
+    expect(empty.headers.get('Content-Length')).toBe('0')
+    expect(await empty.text()).toBe('')
+
+    const invalid = await app.request('/invalid')
+    expect(invalid.status).toBe(502)
+    expect(invalid.headers.get('Content-Length')).toBe('8')
+    expect(await invalid.text()).toBe('not json')
+
+    const consumed = await app.request('/consumed')
+    expect(consumed.status).toBe(200)
+    expect(consumed.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
