diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..11d9790 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,72 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses whose body cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', () => {
+      return new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/304', () => {
+      return new Response(null, { status: 304, headers: { 'Content-Type': 'application/json' } })
+    })
+    app.get('/empty', () => {
+      return new Response('', {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+      })
+    })
+    app.get('/invalid', () => {
+      return new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    })
+    app.use('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+    const res204 = await app.request('http://localhost/204')
+    expect(res204.status).toBe(204)
+    expect(res204.headers.get('Content-Type')).toBe('application/json')
+    expect(res204.body).toBeNull()
+
+    const res304 = await app.request('http://localhost/304')
+    expect(res304.status).toBe(304)
+    expect(res304.body).toBeNull()
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const consumedRes = await app.request('http://localhost/consumed')
+    expect(consumedRes.status).toBe(200)
+    expect(consumedRes.bodyUsed).toBe(true)
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': String(body.length) },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..50f2f25 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,26 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      if (res.body === null || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        obj = JSON.parse(await res.clone().text())
+      } catch {
+        return
+      }
+      const headers = new Headers(res.headers)
+      headers.delete('Content-Length')
+      const prettyRes = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: res.status,
+        statusText: res.statusText,
+        headers,
+      })
+      // Reset first so the setter doesn't copy the stale Content-Length back
+      c.res = undefined
+      c.res = prettyRes
     }
   }
 }
