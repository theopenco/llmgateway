diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..e08bc17 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,79 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('responses that cannot be parsed as JSON', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Custom': 'kept',
+      })
+    )
+
+    it('Should pass through a 204 response with a JSON content-type unchanged', async () => {
+      const res = await app.request('http://localhost/204')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a 304 response with a JSON content-type unchanged', async () => {
+      const res = await app.request('http://localhost/304')
+      expect(res.status).toBe(304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an empty body unchanged', async () => {
+      const res = await app.request('http://localhost/empty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an invalid JSON body unchanged, preserving headers', async () => {
+      const res = await app.request('http://localhost/invalid')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(res.headers.get('X-Custom')).toBe('kept')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should pass through a response whose body was already consumed unchanged', async () => {
+      const app = new Hono()
+      let consumed: string | undefined
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        consumed = await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(consumed).toBe('{"message":"Hono!"}')
+    })
+
+    it('Should remove Content-Length when prettifying', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        c.header('Content-Length', '20')
+        return c.json({ message: 'Hono!' })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
 })
