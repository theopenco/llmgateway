+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8' }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+
+    for (const [path, status, body, length] of [
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(length)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should remove Content-Length from prettified responses', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    }))
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+
+  it('Should pass through responses with an already-used body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'X-Original': 'preserved',
+    }))
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Original')).toBe('preserved')
+  })
+
