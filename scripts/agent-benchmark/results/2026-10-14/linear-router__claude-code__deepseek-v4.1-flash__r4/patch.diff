index ed8404b..695017d 100644
--- a/src/router/linear-router/router.test.ts
+++ b/src/router/linear-router/router.test.ts
@@ -77,4 +77,36 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty path segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/a/:x/:y', 'GET /a/:x/:y')
+    })
+
+    it('GET /u//posts', () => {
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//posts/ with trailing slash', () => {
+      const [res] = router.match('GET', '/u//posts/')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /a//b', () => {
+      const [res] = router.match('GET', '/a//b')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/x/posts', () => {
+      const [res] = router.match('GET', '/u/x/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]).toEqual({ id: 'x' })
+    })
+  })
 })
