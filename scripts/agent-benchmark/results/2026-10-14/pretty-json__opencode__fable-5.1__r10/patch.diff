@@ -50,10 +50,31 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
   return async function prettyJSON(c, next) {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
+    if (!pretty) {
+      return
+    }
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
+    }
+    // Nothing to prettify: contentless responses (e.g. 204/304) or a body
+    // already consumed by another middleware.
+    if (c.res.body === null || c.res.bodyUsed) {
+      return
     }
+
+    const text = await c.res.text()
+    let obj: unknown
+    try {
+      obj = JSON.parse(text)
+    } catch {
+      // Not valid JSON (e.g. empty or proxied body): restore the original body untouched.
+      c.res = new Response(text, c.res)
+      return
+    }
+
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    // The original Content-Length no longer matches the prettified body.
+    c.res.headers.delete('Content-Length')
   }
 }
