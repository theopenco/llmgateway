+  it('Should pass through JSON responses that cannot be prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.body('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Custom': 'preserved',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.body('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Custom': 'preserved',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.body(null, 204, {
+        'Content-Type': 'application/json',
+        'X-Custom': 'preserved',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.body(null, 304, {
+        'Content-Type': 'application/json',
+        'X-Custom': 'preserved',
+      })
+    )
+
+    const emptyRes = await app.request('/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Custom')).toBe('preserved')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Custom')).toBe('preserved')
+    expect(await invalidRes.text()).toBe('not json')
+
+    for (const path of ['/no-content', '/not-modified']) {
+      const res = await app.request(path)
+      expect(res.status).toBe(path === '/no-content' ? 204 : 304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(await res.text()).toBe('')
+    }
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'X-Custom': 'preserved',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Custom')).toBe('preserved')
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
