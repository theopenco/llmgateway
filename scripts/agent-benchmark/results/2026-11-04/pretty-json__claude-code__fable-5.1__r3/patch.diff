index 70b44b6..da5ff6c 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,96 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty by Middleware with unparsable or missing bodies', () => {
+  const invalidJSON = '{"message":'
+
+  it('Should pass through a 204 response with a JSON content-type and no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a 304 response with a JSON content-type and no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' }))
+
+    const res = await app.request('http://localhost/?pretty')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('ETag')).toBe('"abc"')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+
+    const res = await app.request('http://localhost/?pretty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a body that is not valid JSON unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body(invalidJSON, 502, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Content-Length': String(invalidJSON.length),
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json; charset=utf-8')
+    expect(res.headers.get('Content-Length')).toBe(String(invalidJSON.length))
+    expect(await res.text()).toBe(invalidJSON)
+  })
+
+  it('Should pass through a response whose body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove the original Content-Length header when the body is prettified', async () => {
+    const body = '{"message":"Hono!"}'
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Custom': 'kept',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('kept')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
