+  describe.each([
+    { mode: 'query parameter', options: {}, query: '?pretty' },
+    { mode: 'force option', options: { force: true }, query: '' },
+  ])('With $mode', ({ options, query }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: ' \n\t' },
+      { status: 502, body: 'Upstream error: not JSON' },
+    ])(
+      'Should preserve unparseable JSON response $status with body $body',
+      async ({ status, body }) => {
+        const app = new Hono()
+        const headers = new Headers({
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'retained',
+        })
+        app.use('*', prettyJSON(options))
+        app.get('/', () => new Response(body, { status, statusText: 'Upstream status', headers }))
+
+        const res = await app.request(`http://localhost/${query}`)
+        expect(res.status).toBe(status)
+        expect(res.statusText).toBe('Upstream status')
+        expect([...res.headers]).toEqual([...headers])
+        expect(res.bodyUsed).toBe(false)
+        expect(await res.text()).toBe(body ?? '')
+      }
+    )
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const headers = new Headers({
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Upstream': 'retained',
+      })
+      let originalResponse: Response | undefined
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        originalResponse = c.res
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => new Response(body, { status: 202, headers }))
+
+      const res = await app.request(`http://localhost/${query}`)
+      expect(res).toBe(originalResponse)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual([...headers])
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Upstream': 'retained',
+            },
+          })
+      )
+
+      const res = await app.request(`http://localhost/${query}`)
+      expect(res.status).toBe(201)
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Upstream')).toBe('retained')
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
