@@ -120,3 +120,80 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty middleware passthrough', () => {
+  it('Should pass through responses whose bodies cannot be prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      if (c.req.path === '/consumed') {
+        await c.res.text()
+      }
+    })
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+    app.get('/consumed', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', '0'],
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/consumed', 200, '{"message":"Hono!"}', '19'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      if (path !== '/consumed') {
+        expect(await res.text()).toBe(body)
+      }
+    }
+  })
+
+  it('Should remove Content-Length when the response body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
+
