+  it('Should remove the Content-Length header when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should not touch responses that have a JSON content-type but no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) =>
+      c.body(null, 204, {
+        'Content-Type': 'application/json',
+        'X-Test': 'no-content',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.body(null, 304, {
+        'Content-Type': 'application/json',
+        'X-Test': 'not-modified',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.body(null, 200, {
+        'Content-Type': 'application/json',
+        'X-Test': 'empty',
+      })
+    )
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(noContentRes.headers.get('X-Test')).toBe('no-content')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(notModifiedRes.headers.get('X-Test')).toBe('not-modified')
+    expect(await notModifiedRes.text()).toBe('')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(emptyRes.headers.get('X-Test')).toBe('empty')
+    expect(await emptyRes.text()).toBe('')
+  })
+
+  it('Should not touch responses whose JSON content-type body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'invalid',
+      })
+    )
+
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Test')).toBe('invalid')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should not touch responses whose body has already been read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/consumed', async (c) => {
+      const res = c.json({ message: 'Hono!' }, 200, { 'Content-Length': '19' })
+      await res.text()
+      return res
+    })
+
+    const res = await app.request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toMatch('application/json')
+    expect(res.headers.get('Content-Length')).toBe('19')
+  })
+
