     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        const obj = await c.res.clone().json()
+        const res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+          status: c.res.status,
+          statusText: c.res.statusText,
+          headers: c.res.headers,
+        })
+        // Assigning to `c.res` merges the previous response headers back in, so
+        // `Content-Length` has to be dropped after the assignment.
+        c.res = res
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // The body cannot be parsed as JSON (empty, already read, or not JSON),
+        // so the response is passed through unchanged.
+      }
     }
   }
