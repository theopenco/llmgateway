--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,21 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (pretty && contentType && jsonContentTypeRegex.test(contentType) && !c.res.bodyUsed) {
+      try {
+        // Clone before reading: if the body cannot be parsed as JSON (empty or
+        // invalid), the original response must stay untouched so it passes
+        // through unchanged.
+        const obj = JSON.parse(await c.res.clone().text()) as unknown
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+        // The original Content-Length no longer matches the prettified body.
+        // Assigning to `c.res` copies headers from the previous response, so
+        // delete it from the final response.
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // The body cannot be parsed as JSON - pass the response through
+        // unchanged instead of turning it into a 500 error.
+      }
     }
   }
 }
