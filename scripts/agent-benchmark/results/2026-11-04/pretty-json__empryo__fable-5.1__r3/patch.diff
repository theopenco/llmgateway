 import type { MiddlewareHandler } from '../../types'
 
+// Statuses that must not carry a body (new Response() throws if given one)
+const contentlessStatuses = new Set([101, 204, 205, 304])
+
 interface PrettyOptions {
   /**
    * Number of spaces for indentation.
@@ -47,13 +50,36 @@ const jsonContentTypeRegex = /^application\/(?:[a-z0-9._-]+\+)?json(?=$|[;\s])/i
  */
 export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
   const targetQuery = options?.query ?? 'pretty'
+  const space = options?.space ?? 2
   return async function prettyJSON(c, next) {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
-    const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty) {
+      return
+    }
+    const res = c.res
+    const contentType = res.headers.get('Content-Type')
+    if (
+      !contentType ||
+      !jsonContentTypeRegex.test(contentType) ||
+      res.body === null ||
+      res.bodyUsed ||
+      contentlessStatuses.has(res.status)
+    ) {
+      return
+    }
+    const text = await res.text()
+    let obj: unknown
+    try {
+      obj = JSON.parse(text)
+    } catch {
+      // Not valid JSON: restore the original body untouched
+      c.res = new Response(text, res)
+      return
     }
+    c.res = new Response(JSON.stringify(obj, null, space), res)
+    // The original Content-Length no longer matches the prettified body.
+    // Delete it after assignment because the `c.res` setter merges the previous headers in.
+    c.res.headers.delete('Content-Length')
   }
 }
