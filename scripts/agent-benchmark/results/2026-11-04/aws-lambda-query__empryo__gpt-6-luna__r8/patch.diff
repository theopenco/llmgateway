+++ b/src/adapter/aws-lambda/handler.test.ts
@@ -10,6 +10,35 @@ import {
 } from './handler'
 import type { ApiGatewayRequestContextV2 } from './types'
 
+describe('AWS Lambda query string empty values', () => {
+  it('preserves empty values and skips undefined values for API Gateway REST events', () => {
+    const event = {
+      ...baseV1Event,
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+    } as unknown as LambdaEvent
+    const request = getProcessor(event).createRequest(event)
+
+    expect(request.url).toEqual(
+      'https://id.execute-api.us-east-1.amazonaws.com/my/path?empty=&present=0'
+    )
+  })
+
+  it('preserves empty values and skips undefined values for ALB events', () => {
+    const event = {
+      httpMethod: 'GET',
+      path: '/my/path',
+      headers: { host: 'example.com' },
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+      body: null,
+      isBase64Encoded: false,
+      requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+    } as unknown as LambdaEvent
+    const request = getProcessor(event).createRequest(event)
+
+    expect(request.url).toEqual('https://example.com/my/path?empty=&present=0')
+  })
+})
+
 // Base event objects to reduce duplication
