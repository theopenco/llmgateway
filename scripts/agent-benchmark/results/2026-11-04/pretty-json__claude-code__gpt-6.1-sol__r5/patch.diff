+  describe.each([
+    { activation: '?pretty', options: undefined, query: '?pretty' },
+    { activation: 'force: true', options: { force: true }, query: '' },
+  ])('Response preservation with $activation', ({ options, query }) => {
+    it.each([
+      { status: 204, body: null, contentType: 'application/json' },
+      { status: 304, body: null, contentType: 'application/json' },
+      { status: 200, body: '', contentType: 'application/json' },
+      { status: 200, body: ' \n\t', contentType: 'application/json' },
+      { status: 502, body: '<html>Bad Gateway</html>', contentType: 'application/json' },
+      { status: 400, body: '{"error":', contentType: 'application/problem+json' },
+    ])(
+      'Should preserve an unparseable JSON response with status $status and body $body',
+      async ({ status, body, contentType }) => {
+        const response = new Response(body, {
+          status,
+          statusText: 'Original response',
+          headers: {
+            'Content-Type': contentType,
+            'Content-Length': String(body?.length ?? 0),
+            'X-Custom': 'original',
+          },
+        })
+        const headers = [...response.headers]
+        const app = new Hono()
+        app.use('*', prettyJSON(options))
+        app.get('/', () => response)
+
+        const res = await app.request(`/${query}`)
+        expect(res).toBe(response)
+        expect(res.status).toBe(status)
+        expect(res.statusText).toBe('Original response')
+        expect([...res.headers]).toEqual(headers)
+        expect(res.bodyUsed).toBe(false)
+        expect(await res.text()).toBe(body ?? '')
+      }
+    )
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const body = '{"message":"Hono!"}'
+      const response = new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Custom': 'original',
+        },
+      })
+      const headers = [...response.headers]
+      const originalBody = response.body
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(`/${query}`)
+      expect(res).toBe(response)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.body).toBe(originalBody)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it.each([{ message: 'Hono!' }, null])(
+      'Should remove Content-Length only when prettifying %j',
+      async (value) => {
+        const body = JSON.stringify(value)
+        const app = new Hono()
+        app.use('*', prettyJSON(options))
+        app.get(
+          '/',
+          () =>
+            new Response(body, {
+              status: 201,
+              statusText: 'Created',
+              headers: {
+                'Content-Type': 'application/json',
+                'Content-Length': String(body.length),
+                'X-Custom': 'original',
+              },
+            })
+        )
+
+        const res = await app.request(`/${query}`)
+        expect(res.status).toBe(201)
+        expect(res.statusText).toBe('Created')
+        expect([...res.headers]).toEqual([
+          ['content-type', 'application/json'],
+          ['x-custom', 'original'],
+        ])
+        expect(await res.text()).toBe(JSON.stringify(value, null, 2))
+      }
+    )
+  })
+
