diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..e5153e5 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,74 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses with bodies that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse(null, 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Test': 'empty',
+    }))
+    app.get('/invalid', (c) => c.newResponse('not JSON', 502, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Test': 'invalid',
+    }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, {
+      'Content-Type': 'application/json',
+      'X-Test': 'no-content',
+    }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, {
+      'Content-Type': 'application/json',
+      'X-Test': 'not-modified',
+    }))
+
+    for (const [path, status, body, contentLength, testHeader] of [
+      ['/empty', 200, '', '0', 'empty'],
+      ['/invalid', 502, 'not JSON', '8', 'invalid'],
+      ['/no-content', 204, '', null, 'no-content'],
+      ['/not-modified', 304, '', null, 'not-modified'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Test')).toBe(testHeader)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '18',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should pass through a JSON response whose body has already been read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 202, {
+      'Content-Type': 'application/json',
+      'X-Test': 'read',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(202)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Test')).toBe('read')
+  })
 })
