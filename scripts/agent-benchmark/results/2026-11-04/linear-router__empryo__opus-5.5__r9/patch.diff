@@ -77,4 +77,24 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+    })
+
+    it('GET /u//posts', () => {
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/1/posts', () => {
+      const [res] = router.match('GET', '/u/1/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ id: '1' })
+    })
+  })
 })
