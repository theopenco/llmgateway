+  describe('Empty segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/u/:id', 'GET /u/:id')
+      router.add('GET', '/:id', 'GET /:id')
+      router.add('GET', '/entry/:id/:action', 'GET /entry/:id/:action')
+    })
+
+    it('GET /u//posts', () => {
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET //posts', () => {
+      const [res] = router.match('GET', '//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /entry//show', () => {
+      const [res] = router.match('GET', '/entry//show')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /entry/123/', () => {
+      const [res] = router.match('GET', '/entry/123/')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /', () => {
+      const [res] = router.match('GET', '/')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/posts', () => {
+      const [res] = router.match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+
+    it('GET /u/123', () => {
+      const [res] = router.match('GET', '/u/123')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id')
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+
+    it('GET /entry/123/show', () => {
+      const [res] = router.match('GET', '/entry/123/show')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /entry/:id/:action')
+      expect(res[0][1]).toEqual({ id: '123', action: 'show' })
+    })
+  })
+
