+  describe.each([
+    { mode: 'query', options: {}, url: '/?pretty' },
+    { mode: 'force', options: { force: true }, url: '/' },
+  ])('when enabled by $mode', ({ options, url }) => {
+    it.each([
+      { name: '204 response', status: 204, body: null },
+      { name: '304 response', status: 304, body: null },
+      { name: 'null body', status: 200, body: null },
+      { name: 'empty body', status: 200, body: '' },
+      { name: 'invalid JSON from a proxy', status: 502, body: '<html>Bad Gateway</html>' },
+    ])('Should preserve a $name unchanged', async ({ status, body }) => {
+      const original = new Response(body, {
+        status,
+        statusText: 'Original response',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...original.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Original response')
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const body = '{"message":"Hono!"}'
+      const original = new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...original.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const body = '{"message":"Hono!"}'
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            statusText: 'Created',
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Custom': 'preserved',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.statusText).toBe('Created')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+    })
+  })
+
