diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..c5bd22a 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,77 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe.each([false, true])('with force: %s', (force) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 502, body: 'upstream error' },
+    ])('Should preserve unparseable JSON responses: %o', async ({ status, body }) => {
+      const response = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'original',
+        },
+      })
+      const headers = [...response.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get('/', () => response)
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve responses already read by another middleware', async () => {
+      const response = new Response('{"message":"Hono!"}', {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '19' },
+      })
+      const headers = [...response.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res).toBe(response)
+      expect(res.status).toBe(200)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get(
+        '/',
+        () =>
+          new Response('{"message":"Hono!"}', {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': '19',
+              'X-Upstream': 'original',
+            },
+          })
+      )
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res.status).toBe(201)
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Upstream')).toBe('original')
+      expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+    })
+  })
 })
