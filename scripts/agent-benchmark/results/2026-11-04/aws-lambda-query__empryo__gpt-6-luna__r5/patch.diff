+describe('AWS Lambda query string parameters', () => {
+  it('preserves empty query parameter values for v1 API Gateway and ALB events', () => {
+    const v1Event: LambdaEvent = {
+      ...baseV1Event,
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+    }
+    const v1Request = getProcessor(v1Event).createRequest(v1Event)
+    expect(v1Request.url).toBe(
+      'https://id.execute-api.us-east-1.amazonaws.com/my/path?empty=&present=0'
+    )
+
+    const albEvent = {
+      httpMethod: 'GET',
+      path: '/my/path',
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+      body: null,
+      isBase64Encoded: false,
+      requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+    } as unknown as LambdaEvent
+    const albRequest = getProcessor(albEvent).createRequest(albEvent)
+    expect(albRequest.url).toBe('https://undefined/my/path?empty=&present=0')
+  })
+})
