+  describe('Empty path segment', () => {
+    const newRouter = () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/u/:id/:action', 'GET /u/:id/:action')
+      return router
+    }
+
+    it('GET /u//posts', () => {
+      const [res] = newRouter().match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//show', () => {
+      const [res] = newRouter().match('GET', '/u//show')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//posts with a pattern label', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id{.+}/posts', 'GET /u/:id{.+}/posts')
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u// with a pattern label that matches a slash', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id{.+}', 'GET /u/:id{.+}')
+      const [res] = router.match('GET', '/u//')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ id: '/' })
+    })
+
+    it('GET /u/123/posts', () => {
+      const [res] = newRouter().match('GET', '/u/123/posts')
+      expect(res.length).toBe(2)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+  })
+
