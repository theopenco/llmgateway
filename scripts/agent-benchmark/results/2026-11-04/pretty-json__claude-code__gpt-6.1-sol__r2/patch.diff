+  describe.each([
+    { force: false, url: '/?pretty' },
+    { force: true, url: '/' },
+  ])('with force: $force and URL: $url', ({ force, url }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 502, body: 'not JSON' },
+      { status: 200, body: '{"message":' },
+    ])('Should preserve an unparseable response: $status, $body', async ({ status, body }) => {
+      const response = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const response = new Response('{"message":"Hono!"}', {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Custom': 'preserved',
+        },
+      })
+      const headers = [...response.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res).toBe(response)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get(
+        '/',
+        () =>
+          new Response('{"message":"Hono!"}', {
+            status: 201,
+            statusText: 'Created',
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': '19',
+              'X-Custom': 'preserved',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.statusText).toBe('Created')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
