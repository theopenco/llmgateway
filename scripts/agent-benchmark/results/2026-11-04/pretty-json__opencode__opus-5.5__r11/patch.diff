diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..89eb770 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,93 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Custom': 'foo',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('foo')
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Responses with a JSON content-type but a non-JSON body', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/no-content', () => {
+      return new Response(null, {
+        status: 204,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    })
+    app.get('/not-modified', () => {
+      return new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '19' },
+      })
+    })
+    app.get('/empty', (c) => {
+      return c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    })
+    app.get('/invalid', () => {
+      return new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8' },
+      })
+    })
+    app.get('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+    it('Should pass a 204 response through unchanged', async () => {
+      const res = await app.request('http://localhost/no-content?pretty')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.body).toBeNull()
+    })
+
+    it('Should pass a 304 response through unchanged', async () => {
+      const res = await app.request('http://localhost/not-modified?pretty')
+      expect(res.status).toBe(304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('19')
+      expect(res.body).toBeNull()
+    })
+
+    it('Should pass an empty body through unchanged', async () => {
+      const res = await app.request('http://localhost/empty?pretty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass an invalid JSON body through unchanged', async () => {
+      const res = await app.request('http://localhost/invalid?pretty')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should not fail when the body was already consumed', async () => {
+      const res = await app.request('http://localhost/consumed?pretty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..3be1fa6 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,29 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      // Nothing to prettify (e.g. 204/304 or empty body) or the body was already consumed.
+      if (!res.body || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        // Read from a clone so the original body stays intact if parsing fails.
+        obj = JSON.parse(await res.clone().text())
+      } catch {
+        // Not valid JSON: pass the response through unchanged.
+        return
+      }
+      const headers = new Headers(res.headers)
+      // The prettified body has a different length.
+      headers.delete('Content-Length')
+      // Reset first so the setter does not merge the stale Content-Length back in.
+      c.res = undefined
+      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: res.status,
+        statusText: res.statusText,
+        headers,
+      })
     }
   }
 }
