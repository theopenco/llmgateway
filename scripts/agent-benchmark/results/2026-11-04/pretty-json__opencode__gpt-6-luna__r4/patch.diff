+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it.each([
+    ['204 without a body', 204, null],
+    ['304 without a body', 304, null],
+    ['empty body', 200, ''],
+    ['invalid JSON body', 502, 'upstream failure'],
+  ])('Should pass through a JSON response with %s', async (_description, status, body) => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(body, status as 200 | 204 | 304 | 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '17',
+        'X-Upstream': 'preserved',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Length')).toBe('17')
+    expect(res.headers.get('X-Upstream')).toBe('preserved')
+    expect(await res.text()).toBe(body ?? '')
+  })
+
+  it('Should pass through a JSON response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('upstream failure', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '16',
+        'X-Upstream': 'preserved',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('16')
+    expect(res.headers.get('X-Upstream')).toBe('preserved')
+  })
+
