+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'empty',
+        },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('upstream response', {
+        status: 502,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '17',
+          'X-Custom': 'upstream',
+        },
+      })
+    )
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'no-content',
+        },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'not-modified',
+        },
+      })
+    )
+
+    for (const [path, status, body, contentLength, customHeader] of [
+      ['/empty', 200, '', '0', 'empty'],
+      ['/invalid', 502, 'upstream response', '17', 'upstream'],
+      ['/no-content', 204, '', '0', 'no-content'],
+      ['/not-modified', 304, '', '0', 'not-modified'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Custom')).toBe(customHeader)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should not parse a response body already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'X-Custom': 'preserved',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Custom')).toBe('preserved')
+  })
+
+  it('Should remove Content-Length when returning pretty JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+
