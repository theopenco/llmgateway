+  it('Should pass through JSON responses with bodies that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '12',
+          'X-Test': 'same',
+        },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '12',
+          'X-Test': 'same',
+        },
+      })
+    )
+    app.get('/empty', () =>
+      new Response('', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Test': 'same',
+        },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not JSON', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Test': 'same',
+        },
+      })
+    )
+
+    for (const [path, status, body, contentLength] of [
+      ['/no-content', 204, '', '12'],
+      ['/not-modified', 304, '', '12'],
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not JSON', '8'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Test')).toBe('same')
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should pass through JSON responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () =>
+      new Response('not JSON', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Test': 'same',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Test')).toBe('same')
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
