diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..0d0e806 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,71 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Responses with a JSON content-type but an unparsable body', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.body('not json {', 502, {
+        'Content-Type': 'application/json; charset=UTF-8',
+        'Content-Length': '10',
+        'X-Custom': 'kept',
+      })
+    )
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' })
+    )
+
+    it.each([
+      ['/no-content', 204],
+      ['/not-modified', 304],
+      ['/empty', 200],
+    ])('Should pass %s through unchanged', async (path, status) => {
+      const res = await app.request(`http://localhost${path}?pretty`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass an invalid JSON body through unchanged', async () => {
+      const res = await app.request('http://localhost/invalid?pretty')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json; charset=UTF-8')
+      expect(res.headers.get('Content-Length')).toBe('10')
+      expect(res.headers.get('X-Custom')).toBe('kept')
+      expect(await res.text()).toBe('not json {')
+    })
+
+    it('Should not fail when the body was already consumed', async () => {
+      const res = await app.request('http://localhost/consumed?pretty')
+      expect(res.status).toBe(200)
+      expect(res.bodyUsed).toBe(true)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..bc29b3f 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,24 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      // Leave responses without a readable body (204/304, empty, already consumed) untouched
+      if (!res.body || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        // Parse a clone so the original body stays intact if parsing fails
+        obj = await res.clone().json()
+      } catch {
+        return
+      }
+      const prettyRes = new Response(JSON.stringify(obj, null, options?.space ?? 2), res)
+      prettyRes.headers.delete('Content-Length')
+      // prettyRes already carries every header of the original response; reset first so
+      // the setter does not merge the stale Content-Length back in
+      c.res = undefined
+      c.res = prettyRes
     }
   }
 }
