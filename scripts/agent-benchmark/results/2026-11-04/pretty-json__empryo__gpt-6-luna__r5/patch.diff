diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..eb78a0b 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,58 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+
+describe('prettyJSON pass-through responses', () => {
+  it('Should pass through empty and invalid JSON responses unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json', 'ETag': '"test"' }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+    app.get('/invalid', () => new Response('not json', { headers: { 'Content-Type': 'application/json', 'Content-Length': '8' } }))
+
+    for (const [path, status, body, contentLength] of [
+      ['/no-content', 204, '', '0'],
+      ['/not-modified', 304, '', null],
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () => new Response('not json', { headers: { 'Content-Type': 'application/json', 'X-Test': 'preserved' } }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Test')).toBe('preserved')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => new Response('{"message":"Hono!"}', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '18' },
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+})
+
