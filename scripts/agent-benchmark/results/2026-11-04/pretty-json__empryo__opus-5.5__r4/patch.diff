+      const targetQuery = options?.query ?? 'pretty'
+      return async function prettyJSON(c, next) {
+        const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
+        await next()
+        const res = c.res
+        const contentType = res.headers.get('Content-Type')
+        if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+          return
+        }
+        if (!res.body || res.bodyUsed) {
+          return
+        }
+        let obj: unknown
+        try {
+          // Parse a clone so the original body stays intact if it is not valid JSON
+          obj = await res.clone().json()
+        } catch {
+          return
+        }
+        const prettified = new Response(JSON.stringify(obj, null, options?.space ?? 2), res)
+        prettified.headers.delete('Content-Length')
+        // Reset first so the `c.res` setter does not copy the stale Content-Length back
+        c.res = undefined
+        c.res = prettified
+      }
 }
