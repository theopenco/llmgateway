+describe('LinearRouter empty parameter segments', () => {
+  it('does not match an empty middle segment as a named parameter', () => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+    const [matches] = router.match('GET', '/u//posts')
+    expect(matches).toHaveLength(0)
+  })
+})
+
