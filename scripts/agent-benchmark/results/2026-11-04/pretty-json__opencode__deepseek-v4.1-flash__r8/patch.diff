+  it('Should pass through empty body responses (204) with JSON content-type', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/no-content')
+    expect(res.status).toBe(204)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through responses with a body that is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/with-length', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/with-length')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
