+  describe.each([
+    { activation: 'query parameter', force: false },
+    { activation: 'force option', force: true },
+  ])('when activated by $activation', ({ force }) => {
+    it.each([
+      { status: 204, body: null, contentLength: '0' },
+      { status: 304, body: null, contentLength: '123' },
+      { status: 200, body: null, contentLength: '0' },
+      { status: 200, body: '', contentLength: '0' },
+      { status: 200, body: ' \n\t', contentLength: '3' },
+      { status: 502, body: '<html>Bad Gateway</html>', contentLength: '24' },
+    ])(
+      'Should preserve unparseable JSON with status $status and body "$body"',
+      async (testCase) => {
+        const app = new Hono()
+        app.use('*', prettyJSON({ force }))
+        const response = new Response(testCase.body, {
+          status: testCase.status,
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': testCase.contentLength,
+            'X-Upstream': 'original',
+          },
+        })
+        const headers = [...response.headers]
+        app.get('/', () => response)
+
+        const res = await app.request(force ? '/' : '/?pretty')
+        expect(res).toBe(response)
+        expect(res.status).toBe(testCase.status)
+        expect([...res.headers]).toEqual(headers)
+        expect(await res.text()).toBe(testCase.body ?? '')
+      }
+    )
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      const response = new Response('{"message":"Hono!"}', {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Upstream': 'original',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res).toBe(response)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force }))
+      app.get(
+        '/',
+        () =>
+          new Response('{"message":"Hono!"}', {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': '19',
+              'X-Upstream': 'original',
+            },
+          })
+      )
+
+      const res = await app.request(force ? '/' : '/?pretty')
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Upstream')).toBe('original')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+    })
+  })
+
