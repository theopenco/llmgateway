diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..3b0abfb 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,99 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove the original Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should leave responses with an empty body untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should leave 204 responses with a JSON content-type untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should leave 304 responses with a JSON content-type untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should leave responses with an invalid JSON body untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should leave responses whose body was already read untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', async (c) => {
+      const res = c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+      })
+      await res.text()
+      return res
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..bdb9c00 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,23 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+
+    let obj: unknown
+    try {
+      obj = await c.res.clone().json()
+    } catch {
+      // The body is empty, already consumed, or not valid JSON.
+      // Leave the response untouched.
+      return
+    }
+
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    // The original Content-Length no longer matches the prettified body.
+    // It is removed after assignment because the `res` setter merges the
+    // previous response's headers back in.
+    c.res.headers.delete('Content-Length')
   }
 }
