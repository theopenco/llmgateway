diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..c15243e 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,82 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Should pass through JSON content-type responses that cannot be parsed', () => {
+    const jsonHeaders = { 'Content-Type': 'application/json' }
+
+    it.each([204, 304] as const)('%i without a body', async (status) => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.body(null, status, jsonHeaders))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('empty body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON())
+      app.get('/', (c) => c.body('', 200, { ...jsonHeaders, 'Content-Length': '0' }))
+
+      const res = await app.request('http://localhost/?pretty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('invalid JSON body (e.g. proxied response)', async () => {
+      const body = '{"message": "trunc'
+      const app = new Hono()
+      app.use('*', prettyJSON())
+      app.get('/', () =>
+        new Response(body, {
+          status: 502,
+          headers: { ...jsonHeaders, 'Content-Length': String(body.length), 'X-Upstream': 'a' },
+        })
+      )
+
+      const res = await app.request('http://localhost/?pretty')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(String(body.length))
+      expect(res.headers.get('X-Upstream')).toBe('a')
+      expect(await res.text()).toBe(body)
+    })
+
+    it('body already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    })
+  })
 })
