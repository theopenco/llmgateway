diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..cf2ce8f 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,76 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': String(body.length) },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Should pass through JSON responses whose body is not valid JSON', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+    app.get('/invalid', () => {
+      const body = 'not json'
+      return new Response(body, {
+        status: 502,
+        headers: {
+          'Content-Type': 'application/json; charset=UTF-8',
+          'Content-Length': String(body.length),
+          'X-Upstream': 'proxy',
+        },
+      })
+    })
+
+    it.each([
+      ['/204', 204, null, ''],
+      ['/304', 304, null, ''],
+      ['/empty', 200, '0', ''],
+      ['/invalid', 502, '8', 'not json'],
+    ])('%s', async (path, status, contentLength, body) => {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(await res.text()).toBe(body)
+    })
+
+    it('/invalid keeps other headers', async () => {
+      const res = await app.request('http://localhost/invalid')
+      expect(res.headers.get('X-Upstream')).toBe('proxy')
+    })
+  })
+
+  it('Should pass through a JSON response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }, 201))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    expect(res.bodyUsed).toBe(true)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
