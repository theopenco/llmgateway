+describe('EventProcessor.createRequest with empty query values', () => {
+  it.each(['API Gateway v1', 'ALB'])(
+    'Should preserve empty strings and omit undefined for %s',
+    (type) => {
+      const event: LambdaEvent =
+        type === 'ALB'
+          ? {
+              httpMethod: 'GET',
+              path: '/my/path',
+              headers: { host: 'example.com' },
+              body: null,
+              isBase64Encoded: false,
+              requestContext: { elb: { targetGroupArn: 'test-target-group' } },
+            }
+          : { ...baseV1Event }
+      event.queryStringParameters = { empty: '', present: '0', omitted: undefined }
+
+      const request = getProcessor(event).createRequest(event)
+      const domain = type === 'ALB' ? 'example.com' : 'id.execute-api.us-east-1.amazonaws.com'
+
+      expect(request.url).toEqual(`https://${domain}/my/path?empty=&present=0`)
+    }
+  )
+})
