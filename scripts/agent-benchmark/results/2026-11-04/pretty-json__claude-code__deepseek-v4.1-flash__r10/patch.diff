+  it('Should pass through JSON content-types with no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      return c.newResponse(null, 204, { 'Content-Type': 'application/json' })
+    })
+    app.get('/not-modified', (c) => {
+      return c.newResponse(null, 304, { 'Content-Type': 'application/json' })
+    })
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through empty and unparsable JSON bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => {
+      return c.body('', 200, { 'Content-Type': 'application/json' })
+    })
+    app.get('/invalid', (c) => {
+      return c.body('not json', 200, { 'Content-Type': 'application/json' })
+    })
+    app.get('/partial', (c) => {
+      return c.body('{"message":', 502, { 'Content-Type': 'application/json' })
+    })
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(await invalidRes.text()).toBe('not json')
+
+    const partialRes = await app.request('http://localhost/partial')
+    expect(partialRes.status).toBe(502)
+    expect(await partialRes.text()).toBe('{"message":')
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should preserve original headers when passing through unparsable JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.body('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Custom': 'value',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Custom')).toBe('value')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should drop Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
