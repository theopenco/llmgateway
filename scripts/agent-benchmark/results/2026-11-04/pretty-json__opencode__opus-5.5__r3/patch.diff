diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..b0629ee 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,68 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Responses with a JSON content-type but an unparsable body', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/no-content', (c) =>
+      c.body(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+    app.get('/not-modified', (c) =>
+      c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+    )
+    app.get('/empty', (c) =>
+      c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    )
+    app.get('/invalid', (c) =>
+      c.body('not json', 502, { 'Content-Type': 'application/json', 'Content-Length': '8' })
+    )
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' })
+    )
+
+    it.each([
+      ['/no-content', 204, null],
+      ['/not-modified', 304, null],
+      ['/empty', 200, ''],
+      ['/invalid', 502, 'not json'],
+    ])('Should pass %s through unchanged', async (path, status, body) => {
+      const plain = await app.request(path)
+      const res = await app.request(`${path}?pretty`)
+      expect(res.status).toBe(status)
+      expect(Object.fromEntries(res.headers)).toEqual(Object.fromEntries(plain.headers))
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should not throw when the body was already read', async () => {
+      const res = await app.request('/consumed?pretty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    })
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+        'X-Custom': 'kept',
+      })
+    )
+
+    const res = await app.request('/?pretty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('kept')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..f5ea1f7 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,28 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      // Bodiless responses (e.g. 204/304) and already-consumed bodies pass through unchanged
+      if (!res.body || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        // Read from a clone so the original body stays intact if parsing fails
+        obj = await res.clone().json()
+      } catch {
+        return
+      }
+      const headers = new Headers(res.headers)
+      headers.delete('Content-Length')
+      const prettyRes = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: res.status,
+        statusText: res.statusText,
+        headers,
+      })
+      // Reset first so the `c.res` setter does not merge the stale Content-Length back in
+      c.res = undefined
+      c.res = prettyRes
     }
   }
 }
