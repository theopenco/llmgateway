+  describe.each([
+    { name: 'query', options: {}, url: '/?pretty' },
+    { name: 'force', options: { force: true }, url: '/' },
+  ])('When enabled by $name', ({ options, url }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: '   ' },
+      { status: 502, body: '<html>Bad Gateway</html>' },
+    ])('Should preserve an unparseable response: $status, $body', async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const response = new Response(body, {
+        status,
+        statusText: 'Original response',
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Original': 'unchanged',
+        },
+      })
+      const headers = [...response.headers]
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(res.status).toBe(status)
+      expect(res.statusText).toBe('Original response')
+      expect([...res.headers]).toEqual(headers)
+      if (body === null) {
+        expect(res.body).toBeNull()
+      } else {
+        expect(await res.text()).toBe(body)
+      }
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const body = '{"message":"Hono!"}'
+      const response = new Response(body, {
+        status: 202,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Original': 'unchanged',
+        },
+      })
+      const headers = [...response.headers]
+      let consumedBody: string | undefined
+      app.use('*', async (c, next) => {
+        await next()
+        consumedBody = await c.res.text()
+      })
+      app.get('/', () => response)
+
+      const res = await app.request(url)
+      expect(consumedBody).toBe(body)
+      expect(res).toBe(response)
+      expect(res.status).toBe(202)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length when prettifying a response', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const body = '{"message":"Hono!"}'
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Original': 'unchanged',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Original')).toBe('unchanged')
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
+
