 })
+
+describe('LinearRouter named parameter', () => {
+  const router = new LinearRouter<string>()
+  router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+  it('does not match an empty segment in the middle of the path', () => {
+    expect(router.match('GET', '/u//posts')).toEqual([[]])
+  })
+
+  it('matches a non-empty segment in the middle of the path', () => {
+    expect(router.match('GET', '/u/123/posts')).toEqual([[['GET /u/:id/posts', { id: '123' }]]])
+  })
+})
