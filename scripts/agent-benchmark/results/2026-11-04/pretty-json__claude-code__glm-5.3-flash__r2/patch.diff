diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..d9c9661 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,75 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through a 204 response with a JSON content-type and no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an empty-bodied response with a JSON content-type', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a response whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/proxy', (c) =>
+      c.body('not json at all', 200, {
+        'Content-Type': 'application/json',
+        'X-Custom': 'keep-me',
+      })
+    )
+
+    const res = await app.request('http://localhost/proxy')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Custom')).toBe('keep-me')
+    expect(await res.text()).toBe('not json at all')
+  })
+
+  it('Should pass through a response whose body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove the Content-Length header when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..deb9804 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,21 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (pretty && contentType && jsonContentTypeRegex.test(contentType) && !c.res.bodyUsed) {
+      let obj: unknown
+      try {
+        obj = await c.res.clone().json()
+      } catch {
+        return
+      }
+      const headers = new Headers(c.res.headers)
+      headers.delete('Content-Length')
+      c.res.headers.delete('Content-Length')
+      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: c.res.status,
+        statusText: c.res.statusText,
+        headers,
+      })
     }
   }
 }
