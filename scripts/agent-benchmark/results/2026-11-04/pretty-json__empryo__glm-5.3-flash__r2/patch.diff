--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,79 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through responses with a JSON content-type but no parseable body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) => c.body('not json', 200, { 'Content-Type': 'application/json' }))
+    app.get('/consumed', async (c) => {
+      const res = new Response('{"message":"Hono!"}', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      })
+      await res.text() // Body already read by another middleware
+      return c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+      })
+    })
+
+    const noBodyRes = await app.request('http://localhost/204')
+    expect(noBodyRes.status).toBe(204)
+    expect(await noBodyRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/304')
+    expect(notModifiedRes.status).toBe(304)
+    expect(await notModifiedRes.text()).toBe('')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(await invalidRes.text()).toBe('not json')
+
+    const consumedRes = await app.request('http://localhost/consumed')
+    expect(consumedRes.status).toBe(200)
+    expect(await consumedRes.text()).toBe('{"message":"Hono!"}')
+  })
+
+  it('Should remove the original Content-Length header when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should keep the Content-Length header when the body is already pretty', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{\n  "message": "Hono!"\n}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '22',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('22')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
