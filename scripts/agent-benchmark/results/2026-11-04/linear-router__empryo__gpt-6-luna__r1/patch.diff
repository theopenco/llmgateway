+describe('LinearRouter empty parameter', () => {
+  it('does not match an empty path segment as a named parameter', () => {
+    const router = new LinearRouter<string>()
+    router.add('GET', '/u/:id/posts', 'route')
+
+    const [res] = router.match('GET', '/u//posts')
+    expect(res).toHaveLength(0)
+  })
+})
