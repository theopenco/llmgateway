@@ -52,8 +52,16 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        // Parse a clone so the original response body stays intact when the
+        // body is not valid JSON (e.g. empty body) and can be passed through.
+        const obj = await c.res.clone().json()
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // Body is not valid JSON or has already been consumed (e.g. by another
+        // middleware) - pass the response through unchanged.
+      }
     }
   }
 }
