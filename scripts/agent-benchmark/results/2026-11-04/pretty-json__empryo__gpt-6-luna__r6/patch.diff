diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..7e4c6a0 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,78 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+it('Should pass through JSON responses that cannot be prettified', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/invalid', (c) =>
+    c.newResponse('not json', 502, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+    })
+  )
+  app.get('/empty', (c) =>
+    c.newResponse('', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+    })
+  )
+  app.get('/no-content', (c) =>
+    c.newResponse(null, 204, { 'Content-Type': 'application/json' })
+  )
+  app.get('/not-modified', (c) =>
+    c.newResponse(null, 304, { 'Content-Type': 'application/json' })
+  )
+
+  for (const [path, status, body, contentLength] of [
+    ['/invalid', 502, 'not json', '8'],
+    ['/empty', 200, '', '0'],
+    ['/no-content', 204, '', null],
+    ['/not-modified', 304, '', null],
+  ] as const) {
+    const res = await app.request(`http://localhost${path}`)
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe(contentLength)
+    expect(await res.text()).toBe(body)
+  }
+})
+
+it('Should remove the original Content-Length when pretty-printing JSON', async () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/', (c) =>
+    c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    })
+  )
+
+  const res = await app.request('http://localhost/')
+  expect(res.headers.has('Content-Length')).toBe(false)
+  expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+})
+
+it('Should pass through JSON responses whose body was already read', async () => {
+  const app = new Hono()
+  let readBody = ''
+  app.use('*', prettyJSON({ force: true }))
+  app.use('*', async (c, next) => {
+    await next()
+    readBody = await c.res.text()
+  })
+  app.get('/', (c) =>
+    c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    })
+  )
+
+  const res = await app.request('http://localhost/')
+  expect(res.status).toBe(200)
+  expect(res.headers.get('Content-Type')).toBe('application/json')
+  expect(res.headers.get('Content-Length')).toBe('19')
+  expect(readBody).toBe('{"message":"Hono!"}')
+})
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..7ec272d 100644
