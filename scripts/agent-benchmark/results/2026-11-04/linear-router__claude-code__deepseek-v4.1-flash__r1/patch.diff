+  describe('Empty path segment', () => {
+    it('GET /u//posts does not match /u/:id/posts', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u//posts does not match any other label route', () => {
+      for (const route of ['/:id/posts', '/u/:id{.+}/posts', '/u/:id{[a-z]+}/posts']) {
+        const router = new LinearRouter<string>()
+        router.add('GET', route, route)
+
+        const [res] = router.match('GET', '/u//posts')
+        expect(res.length, route).toBe(0)
+      }
+    })
+
+    it('GET /u/123/posts still matches /u/:id/posts', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+      const [res] = router.match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+  })
