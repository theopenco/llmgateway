+        ...baseV1Event,
+        headers: { host: 'example.com' },
+        requestContext: {
+          elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' },
+        },
+      } as LambdaEvent,
+    ],
+  ])('preserves empty strings and skips undefined values for %s', (_name, baseEvent) => {
+    const event = {
+      ...baseEvent,
+      queryStringParameters: {
+        empty: '',
+        present: '0',
+        omitted: undefined,
+      },
+    } as LambdaEvent
+
+    const request = getProcessor(event).createRequest(event)
+
+    const expectedHost =
+      event.headers?.host === 'example.com'
+        ? 'example.com'
+        : 'id.execute-api.us-east-1.amazonaws.com'
+    expect(request.url).toEqual(`https://${expectedHost}/my/path?empty=&present=0`)
+  })
+})
