+  it('Should pass through responses whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, { 'Content-Type': 'application/json', 'X-Custom': 'yes' })
+    )
+    app.get('/proxied', (c) =>
+      c.body('<html>upstream error</html>', 502, { 'Content-Type': 'application/json' })
+    )
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(invalidRes.headers.get('X-Custom')).toBe('yes')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const proxiedRes = await app.request('http://localhost/proxied')
+    expect(proxiedRes.status).toBe(502)
+    expect(await proxiedRes.text()).toBe('<html>upstream error</html>')
+  })
+
+  it('Should pass through bodiless JSON responses such as 204 and 304', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should keep Content-Length when passing through and drop it when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/pretty', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '17',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8' })
+    )
+
+    const prettyRes = await app.request('http://localhost/pretty')
+    expect(prettyRes.headers.get('Content-Length')).toBeNull()
+    expect(await prettyRes.text()).toBe(`{
+  "message": "Hono!"
+}`)
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(await invalidRes.text()).toBe('not json')
+  })
+
