+  it('Should pass through JSON content-types with empty or invalid bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) =>
+      c.newResponse(null, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'empty',
+      })
+    )
+    app.get('/invalid', (c) =>
+      c.newResponse('{invalid', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Response': 'invalid',
+      })
+    )
+    app.get('/204', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'no-content',
+      })
+    )
+    app.get('/304', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'not-modified',
+      })
+    )
+
+    for (const [path, status, contentLength, responseHeader, body] of [
+      ['/empty', 200, '0', 'empty', ''],
+      ['/invalid', 502, '8', 'invalid', '{invalid'],
+      ['/204', 204, '0', 'no-content', ''],
+      ['/304', 304, '0', 'not-modified', ''],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Response')).toBe(responseHeader)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should leave a response alone when its body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 202, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+        'X-Response': 'read',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(202)
+    expect(res.headers.get('Content-Length')).toBe('19')
+    expect(res.headers.get('X-Response')).toBe('read')
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
+
