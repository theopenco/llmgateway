+it('preserves empty query parameter values in API Gateway REST and ALB events', () => {
+  const queryStringParameters = { empty: '', present: '0', omitted: undefined }
+  const v1Event: LambdaEvent = { ...baseV1Event, queryStringParameters }
+  const v1Request = getProcessor(v1Event).createRequest(v1Event)
+  const albEvent = {
+    httpMethod: 'GET',
+    path: '/my/path',
+    headers: { host: 'example.com' },
+    body: null,
+    isBase64Encoded: false,
+    queryStringParameters,
+    requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+  } as unknown as LambdaEvent
+  const albRequest = getProcessor(albEvent).createRequest(albEvent)
+
+  expect(new URL(v1Request.url).search).toBe('?empty=&present=0')
+  expect(new URL(albRequest.url).search).toBe('?empty=&present=0')
+})
+
