diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..b633a43 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,114 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through empty and invalid JSON responses unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'preserved',
+        },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not JSON', {
+        status: 502,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Custom': 'preserved',
+        },
+      })
+    )
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Custom')).toBe('preserved')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Custom')).toBe('preserved')
+    expect(await invalidRes.text()).toBe('not JSON')
+  })
+
+  it('Should pass through bodyless 204 and 304 responses unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'preserved',
+        },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '0',
+          'X-Custom': 'preserved',
+        },
+      })
+    )
+
+    for (const [path, status] of [['/no-content', 204], ['/not-modified', 304]] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(res.headers.get('X-Custom')).toBe('preserved')
+      expect(await res.text()).toBe('')
+    }
+  })
+
+  it('Should not consume an invalid JSON response while passing it through', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      const body = await c.res.text()
+      c.res = new Response(body, c.res)
+    })
+    app.get('/', () =>
+      new Response('not JSON', {
+        headers: { 'Content-Type': 'application/json' },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('not JSON')
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
