@@ -120,3 +120,56 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('prettyJSON with unparseable responses', () => {
+  it('passes through responses it cannot parse and removes stale Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      if (c.req.path === '/consumed') {
+        await c.res.text()
+      }
+    })
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+    }))
+    app.get('/consumed', (c) => c.newResponse('{"message":"original"}', 200, {
+      'Content-Type': 'application/json',
+    }))
+    app.get('/valid', (c) => c.newResponse('{"message":"pretty"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '20',
+    }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json' }))
+
+    for (const path of ['/empty', '/invalid', '/consumed', '/no-content', '/not-modified']) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).not.toBe(500)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      if (path === '/no-content') {
+        expect(res.status).toBe(204)
+      }
+      if (path === '/not-modified') {
+        expect(res.status).toBe(304)
+      }
+    }
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(await invalidRes.text()).toBe('not json')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+
+    const consumedRes = await app.request('http://localhost/consumed')
+    expect(consumedRes.status).toBe(200)
+    expect(consumedRes.headers.get('Content-Type')).toBe('application/json')
+
+    const validRes = await app.request('http://localhost/valid')
+    expect(await validRes.text()).toBe(`{
+  "message": "pretty"
+}`)
+    expect(validRes.headers.has('Content-Length')).toBe(false)
+  })
+})
