diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..83f5526 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,84 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through a 204 response with a JSON content-type and no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(204)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a 304 response with a JSON content-type and no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(304)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a response with a JSON content-type and an empty body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through a proxied response whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/proxy', (c) => {
+      return c.newResponse('not valid json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '14',
+      })
+    })
+
+    const res = await app.request('http://localhost/proxy')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('14')
+    expect(await res.text()).toBe('not valid json')
+  })
+
+  it('Should not error when the response body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      const res = new Response('{"message":"Hono!"}', {
+        headers: { 'Content-Type': 'application/json' },
+      })
+      await res.text() // body is now disturbed
+      c.res = res
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should remove the stale Content-Length header when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..0fbfff1 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,18 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
+      // Read from a clone so that the response is kept intact when the body is not parseable as JSON
+      let obj: unknown
+      try {
+        obj = await c.res.clone().json()
+      } catch {
+        // e.g. an empty 204 response or a body that is not valid JSON
+        return
+      }
+      await c.res.body?.cancel()
       c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      // The length of the body has changed, so remove the stale Content-Length
+      c.res.headers.delete('Content-Length')
     }
   }
 }
