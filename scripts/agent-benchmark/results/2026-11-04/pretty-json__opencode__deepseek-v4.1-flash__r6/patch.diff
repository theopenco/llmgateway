+  it('Should pass through JSON content-type responses without a body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', () => {
+      return new Response(null, {
+        status: 204,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    })
+    app.get('/not-modified', () => {
+      return new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    })
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through JSON content-type responses with an empty body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      return new Response('', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through JSON content-type responses whose body is not valid JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      return new Response('not json', {
+        status: 200,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+        },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should pass through when the body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      return new Response('{"message":"Hono!"}', {
+        status: 200,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+        },
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
