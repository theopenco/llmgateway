diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..45de8dc 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,79 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON content-types with absent, empty, or invalid bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Original': 'no-content',
+    }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Original': 'not-modified',
+    }))
+    app.get('/empty', (c) => c.newResponse('', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Original': 'empty',
+    }))
+    app.get('/invalid', (c) => c.newResponse('not JSON', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Original': 'invalid',
+    }))
+
+    for (const [path, status, body, contentLength, original] of [
+      ['/no-content', 204, '', '0', 'no-content'],
+      ['/not-modified', 304, '', '0', 'not-modified'],
+      ['/empty', 200, '', '0', 'empty'],
+      ['/invalid', 200, 'not JSON', '8', 'invalid'],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Original')).toBe(original)
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should not fail when another middleware reads the response body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+      'X-Original': 'read',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('19')
+    expect(res.headers.get('X-Original')).toBe('read')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    expect(res.headers.has('Content-Length')).toBe(false)
+  })
 })
