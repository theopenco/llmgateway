diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..681aec1 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,96 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = JSON.stringify({ message: 'Hono!' })
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  describe('Should pass through JSON responses that cannot be prettified', () => {
+    it('204 with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.body).toBeNull()
+    })
+
+    it('304 with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) =>
+        c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+      )
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(304)
+      expect(res.headers.get('ETag')).toBe('"abc"')
+      expect(res.body).toBeNull()
+    })
+
+    it('empty body with a JSON content-type', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) =>
+        c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+      )
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('body that is not valid JSON (e.g. proxied response)', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) =>
+        c.body('<html>Bad Gateway</html>', 502, {
+          'Content-Type': 'application/json',
+          'Content-Length': '24',
+          'X-Upstream': 'yes',
+        })
+      )
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('24')
+      expect(res.headers.get('X-Upstream')).toBe('yes')
+      expect(await res.text()).toBe('<html>Bad Gateway</html>')
+    })
+
+    it('body that was already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.bodyUsed).toBe(true)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..c68cb73 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,26 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+    // Nothing to prettify: no body (e.g. 204 / 304) or the body was already consumed.
+    if (c.res.body === null || c.res.bodyUsed) {
+      return
+    }
+
+    const text = await c.res.text()
+    let obj: unknown
+    try {
+      obj = JSON.parse(text)
+    } catch {
+      // Not valid JSON: restore the original body and leave the response untouched.
+      c.res = new Response(text, c.res)
+      return
+    }
+
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    // The prettified body has a different length than the original one.
+    c.res.headers.delete('Content-Length')
   }
 }
