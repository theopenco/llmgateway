+      } as unknown as LambdaEvent,
+    ],
+  ])('preserves empty and omits undefined query values for %s', (_name, baseEvent) => {
+    const event = {
+      ...baseEvent,
+      queryStringParameters: {
+        empty: '',
+        present: '0',
+        omitted: undefined,
+      },
+    } as LambdaEvent
+
+    const processor = getProcessor(event)
+    const request = processor.createRequest(event)
+
+    expect(request.url).toMatch(/\/my\/path\?empty=&present=0$/)
+  })
+})
