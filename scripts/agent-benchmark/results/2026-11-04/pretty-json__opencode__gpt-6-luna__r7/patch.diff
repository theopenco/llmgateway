   it('Should return pretty JSON output with 4 spaces', async () => {
@@ -119,4 +121,73 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', () =>
+      new Response('', {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '0', 'X-Test': 'empty' },
+      })
+    )
+    app.get('/invalid', () =>
+      new Response('not json', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '8', 'X-Test': 'proxy' },
+      })
+    )
+    app.get('/no-content', () =>
+      new Response(null, {
+        status: 204,
+        headers: { 'Content-Type': 'application/json', 'X-Test': 'no-content' },
+      })
+    )
+    app.get('/not-modified', () =>
+      new Response(null, {
+        status: 304,
+        headers: { 'Content-Type': 'application/json', 'X-Test': 'not-modified' },
+      })
+    )
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Test')).toBe('empty')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('proxy')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(noContentRes.headers.get('X-Test')).toBe('no-content')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(notModifiedRes.headers.get('X-Test')).toBe('not-modified')
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        status: 202,
+        headers: { 'Content-Type': 'application/json', 'X-Test': 'read' },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(202)
+    expect(res.headers.get('X-Test')).toBe('read')
+  })
 })
