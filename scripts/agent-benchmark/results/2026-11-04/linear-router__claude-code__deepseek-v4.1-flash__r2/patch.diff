diff --git a/src/router/linear-router/router.test.ts b/src/router/linear-router/router.test.ts
index ed8404b..a27616c 100644
--- a/src/router/linear-router/router.test.ts
+++ b/src/router/linear-router/router.test.ts
@@ -77,4 +77,52 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty path segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/a/:x/:y/b', 'GET /a/:x/:y/b')
+      router.add('GET', '/book/:id', 'GET /book/:id')
+    })
+
+    it('GET /u//posts', () => {
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /a//z/b', () => {
+      const [res] = router.match('GET', '/a//z/b')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /a/x//b', () => {
+      const [res] = router.match('GET', '/a/x//b')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /a///b', () => {
+      const [res] = router.match('GET', '/a///b')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /book//', () => {
+      const [res] = router.match('GET', '/book//')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/posts', () => {
+      const [res] = router.match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ id: '123' })
+    })
+
+    it('GET /a/x/y/b', () => {
+      const [res] = router.match('GET', '/a/x/y/b')
+      expect(res.length).toBe(1)
+      expect(res[0][1]).toEqual({ x: 'x', y: 'y' })
+    })
+  })
 })
