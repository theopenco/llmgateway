index 70b44b6..3454914 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,86 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty by Middleware - unparsable bodies', () => {
+  const setup = () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      return c.body(null, 204, { 'Content-Type': 'application/json' })
+    })
+    app.get('/not-modified', (c) => {
+      return c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+    })
+    app.get('/empty', (c) => {
+      return c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+    })
+    app.get('/invalid', (c) => {
+      return c.body('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Upstream': 'proxy',
+      })
+    })
+    app.get('/consumed', async (c) => {
+      const res = c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+      await res.text()
+      return res
+    })
+    app.get('/valid', (c) => {
+      return c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    })
+    return app
+  }
+
+  it('Should pass through a 204 with a JSON content-type and no body', async () => {
+    const res = await setup().request('http://localhost/no-content')
+    expect(res.status).toBe(204)
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through a 304 with a JSON content-type and no body', async () => {
+    const res = await setup().request('http://localhost/not-modified')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('ETag')).toBe('"abc"')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const res = await setup().request('http://localhost/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body with the original status, headers and body', async () => {
+    const res = await setup().request('http://localhost/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Upstream')).toBe('proxy')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should not throw when the body was already consumed', async () => {
+    const res = await setup().request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('19')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove a stale Content-Length header when the body is prettified', async () => {
+    const res = await setup().request('http://localhost/valid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
