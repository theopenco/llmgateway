--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,78 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty by Middleware with unparsable bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+  app.get('/not-modified', (c) =>
+    c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+  )
+  app.get('/empty', (c) =>
+    c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+  )
+  app.get('/invalid', (c) =>
+    c.body('<html>upstream error</html>', 502, {
+      'Content-Type': 'application/json',
+      'Content-Length': '27',
+      'X-Upstream': 'proxy',
+    })
+  )
+  app.use('/consumed', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+  app.get('/valid', (c) =>
+    c.body('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    })
+  )
+
+  it('Should pass through a 204 with a JSON content-type', async () => {
+    const res = await app.request('http://localhost/no-content')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through a 304 with a JSON content-type', async () => {
+    const res = await app.request('http://localhost/not-modified')
+    expect(res.status).toBe(304)
+    expect(res.headers.get('ETag')).toBe('"abc"')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const res = await app.request('http://localhost/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body with its status and headers', async () => {
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('27')
+    expect(res.headers.get('X-Upstream')).toBe('proxy')
+    expect(await res.text()).toBe('<html>upstream error</html>')
+  })
+
+  it('Should not throw when the body was already consumed', async () => {
+    const res = await app.request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const res = await app.request('http://localhost/valid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
