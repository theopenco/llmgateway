diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..ad2be63 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,55 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('JSON pretty by Middleware with unparseable JSON bodies', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) => c.body('not json', 200, { 'Content-Type': 'application/json' }))
+    app.get('/consumed', async (c, next) => {
+      await next()
+      await c.res.text()
+      c.res = new Response('{"message":"Hono!"}', {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    })
+    app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+
+    const cases: [string, number, string][] = [
+      ['/204', 204, ''],
+      ['/304', 304, ''],
+      ['/empty', 200, ''],
+      ['/invalid', 200, 'not json'],
+      ['/consumed', 200, '{\n  "message": "Hono!"\n}'],
+    ]
+
+    cases.forEach(([path, status, body]) => {
+      it(`Should pass through the response from ${path} unchanged`, async () => {
+        const res = await app.request(`http://localhost${path}`)
+        expect(res.status).toBe(status)
+        expect(await res.text()).toBe(body)
+      })
+    })
+
+    it('Should remove the original Content-Length header when prettifying', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.newResponse('{"message":"Hono!"}', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '20',
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
 })
