diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..92f30f8 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,93 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Responses that cannot be prettified', () => {
+    it('Should pass through a 204 response with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a 304 response with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(304)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an empty body with a JSON content-type', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a body that is not valid JSON', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) =>
+        c.newResponse('not json', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+          'X-Response-Id': '123',
+        })
+      )
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(res.headers.get('X-Response-Id')).toBe('123')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should pass through a response whose body was already read', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        // Consume the body before `prettyJSON` inspects it.
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      // The response is passed through untouched, so its body stays consumed.
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        const body = JSON.stringify({ message: 'Hono!' })
+        return c.newResponse(body, 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..cfbaa2f 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,40 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+
+    // The body may be empty (e.g. `204`/`304`), not valid JSON (e.g. a proxied
+    // response) or already consumed by another middleware. Such responses are
+    // passed through as they are.
+    if (c.res.bodyUsed) {
+      return
+    }
+
+    let text: string
+    try {
+      text = await c.res.clone().text()
+    } catch {
+      return
+    }
+    if (!text) {
+      return
+    }
+
+    let obj: unknown
+    try {
+      obj = JSON.parse(text)
+    } catch {
+      return
+    }
+
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+      status: c.res.status,
+      statusText: c.res.statusText,
+      headers: c.res.headers,
+    })
+    // The prettified body has a different length than the original one.
+    c.res.headers.delete('Content-Length')
   }
 }
