@@ -77,4 +77,24 @@ describe('LinearRouter', () => {
       expect(res.length).toBe(0)
     })
   })
+
+  describe('Empty path segment', () => {
+    it('GET /u//posts', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+      const [res] = router.match('GET', '/u//posts')
+      expect(res.length).toBe(0)
+    })
+
+    it('GET /u/123/posts', () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+
+      const [res] = router.match('GET', '/u/123/posts')
+      expect(res.length).toBe(1)
+      expect(res[0][0]).toBe('GET /u/:id/posts')
+      expect(res[0][1]['id']).toBe('123')
+    })
+  })
 })
