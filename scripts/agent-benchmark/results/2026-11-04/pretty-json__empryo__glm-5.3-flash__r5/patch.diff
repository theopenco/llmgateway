diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..0cc88c1 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,59 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through responses with a JSON content-type but an unparseable body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) => c.body('not json', 200, { 'Content-Type': 'application/json' }))
+    app.get('/already-read', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/already-read', (c) => c.body('{"message":"Hono!"}', 200, { 'Content-Type': 'application/json' }))
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(await notModifiedRes.text()).toBe('')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(await invalidRes.text()).toBe('not json')
+
+    // The body was consumed by the inner middleware, so it cannot be read
+    // again here; the regression is that this used to turn into a 500.
+    const alreadyReadRes = await app.request('http://localhost/already-read')
+    expect(alreadyReadRes.status).toBe(200)
+    expect(alreadyReadRes.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should delete the Content-Length header when prettifying the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..db41fd6 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,19 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        // Parse a clone so the original body is preserved when the content
+        // turns out not to be valid JSON (e.g. an empty body or a proxied
+        // response) or the body was already read by another middleware.
+        const obj = await c.res.clone().json()
+        // The original Content-Length no longer matches the new body. Delete
+        // it from the current response before assignment: the Context setter
+        // copies these headers onto the replacement Response.
+        c.res.headers.delete('Content-Length')
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      } catch {
+        // Not parseable as JSON — pass the response through unchanged.
+      }
     }
   }
 }
