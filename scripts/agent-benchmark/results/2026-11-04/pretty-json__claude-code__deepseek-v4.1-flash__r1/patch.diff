 const jsonContentTypeRegex = /^application\/(?:[a-z0-9._-]+\+)?json(?=$|[;\s])/i
 
+const prettify = async (res: Response, space: number): Promise<Response | null> => {
+  let obj: unknown
+  try {
+    obj = JSON.parse(await res.clone().text())
+  } catch {
+    return null
+  }
+
+  try {
+    return new Response(JSON.stringify(obj, null, space), res)
+  } catch {
+    return null
+  }
+}
+
 /**
  * Pretty JSON Middleware for Hono.
  *
