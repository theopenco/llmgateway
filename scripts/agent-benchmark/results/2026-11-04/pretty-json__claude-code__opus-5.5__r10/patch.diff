diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..e07b895 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,72 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Responses whose body cannot be prettified', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', () => new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } }))
+    app.get('/304', () => new Response(null, { status: 304, headers: { 'Content-Type': 'application/json' } }))
+    app.get('/empty', () => new Response('', { headers: { 'Content-Type': 'application/json', 'Content-Length': '0' } }))
+    app.get('/invalid', () =>
+      new Response('not json{', {
+        status: 502,
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '9', 'X-Upstream': 'yes' },
+      })
+    )
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' })
+    )
+
+    it.each([204, 304])('Should pass through a %i response unchanged', async (status) => {
+      const res = await app.request(`http://localhost/${status}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.body).toBeNull()
+    })
+
+    it('Should pass through an empty body unchanged', async () => {
+      const res = await app.request('http://localhost/empty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an invalid JSON body unchanged', async () => {
+      const res = await app.request('http://localhost/invalid')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Length')).toBe('9')
+      expect(res.headers.get('X-Upstream')).toBe('yes')
+      expect(await res.text()).toBe('not json{')
+    })
+
+    it('Should pass through a response whose body was already read', async () => {
+      const res = await app.request('http://localhost/consumed')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    })
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () =>
+      new Response('{"message":"Hono!"}', {
+        headers: { 'Content-Type': 'application/json', 'Content-Length': '19', 'X-Keep': '1' },
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Keep')).toBe('1')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..daf11ae 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,26 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+    const res = c.res
+    if (!res.body || res.bodyUsed) {
+      return
+    }
+    let obj: unknown
+    try {
+      obj = JSON.parse(await res.clone().text())
+    } catch {
+      return
+    }
+    const headers = new Headers(res.headers)
+    headers.delete('Content-Length')
+    c.res = undefined
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+      status: res.status,
+      statusText: res.statusText,
+      headers,
+    })
   }
 }
