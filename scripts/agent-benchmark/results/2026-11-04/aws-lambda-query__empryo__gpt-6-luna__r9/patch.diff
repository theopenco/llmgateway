+describe('empty query string values', () => {
+  it.each([
+    ['API Gateway REST', baseV1Event],
+    [
+      'ALB',
+      {
+        httpMethod: 'GET',
+        path: '/my/path',
+        headers: { host: 'example.test' },
+        body: null,
+        isBase64Encoded: false,
+        requestContext: { elb: { targetGroupArn: 'arn:aws:elasticloadbalancing:...' } },
+      } as unknown as LambdaEvent,
+    ],
+  ])('preserves empty values for %s events', (_eventType, baseEvent) => {
+    const queryEvent = {
+      ...baseEvent,
+      queryStringParameters: { empty: '', present: '0', omitted: undefined },
+    } as LambdaEvent
+
+    const request = getProcessor(queryEvent).createRequest(queryEvent)
+
+    expect(new URL(request.url).search).toBe('?empty=&present=0')
+  })
+})
