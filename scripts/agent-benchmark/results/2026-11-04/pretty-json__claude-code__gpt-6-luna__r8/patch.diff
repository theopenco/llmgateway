+  it('Should pass through responses with JSON content-types and non-JSON bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid-json', (c) =>
+      c.newResponse('not JSON', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Response': 'kept',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'kept',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'kept',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+        'X-Response': 'kept',
+      })
+    )
+
+    for (const [path, status, body] of [
+      ['/invalid-json', 200, 'not JSON'],
+      ['/empty', 200, ''],
+      ['/no-content', 204, ''],
+      ['/not-modified', 304, ''],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('' + body.length)
+      expect(res.headers.get('X-Response')).toBe('kept')
+      expect(await res.text()).toBe(body)
+    }
+  })
+
+  it('Should not fail when another middleware has already read the response body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('not JSON', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Response': 'kept',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Response')).toBe('kept')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
