+  describe.each([
+    { mode: 'query', options: undefined, url: '/?pretty' },
+    { mode: 'force', options: { force: true }, url: '/' },
+  ])('When activated by $mode', ({ options, url }) => {
+    it.each([
+      { status: 204, body: null },
+      { status: 304, body: null },
+      { status: 200, body: null },
+      { status: 200, body: '' },
+      { status: 200, body: ' \n' },
+      { status: 502, body: '<html>Bad Gateway</html>' },
+    ])('Should preserve a non-JSON body ($status, $body)', async ({ status, body }) => {
+      const app = new Hono()
+      const original = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Test': 'unchanged',
+        },
+      })
+      const headers = [...original.headers]
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response whose body was already consumed', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const original = new Response(body, {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+        },
+      })
+      const headers = [...original.headers]
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        expect(await c.res.text()).toBe(body)
+      })
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.body).toBe(original.body)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should preserve a response whose body is locked', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      const original = new Response(body, {
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+        },
+      })
+      const headers = [...original.headers]
+      const reader = original.body!.getReader()
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      try {
+        const res = await app.request(url)
+        expect(res).toBe(original)
+        expect(res.status).toBe(200)
+        expect([...res.headers]).toEqual(headers)
+        const { value } = await reader.read()
+        expect(new TextDecoder().decode(value)).toBe(body)
+      } finally {
+        reader.releaseLock()
+      }
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const app = new Hono()
+      const body = '{"message":"Hono!"}'
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response(body, {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': String(body.length),
+              'X-Test': 'unchanged',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.headers.has('Content-Length')).toBe(false)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('X-Test')).toBe('unchanged')
+      expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+    })
+  })
+
+  it('Should preserve Content-Length when prettification is not requested', async () => {
+    const app = new Hono()
+    const body = '{"message":"Hono!"}'
+    app.use('*', prettyJSON())
+    app.get(
+      '/',
+      () =>
+        new Response(body, {
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': String(body.length),
+          },
+        })
+    )
+
+    const res = await app.request('/')
+    expect(res.headers.get('Content-Length')).toBe(String(body.length))
+    expect(await res.text()).toBe(body)
+  })
+
   it('Should not touch responses with non-JSON content-types', async () => {
     const app = new Hono()
     app.use('*', prettyJSON({ force: true }))
