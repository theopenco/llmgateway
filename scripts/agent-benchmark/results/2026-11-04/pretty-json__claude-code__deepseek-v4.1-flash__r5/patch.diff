diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..f49aed6 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,119 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Non-parsable JSON bodies', () => {
+    it('Should pass through null body statuses with a JSON content-type', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/no-content', (c) => {
+        return c.body(null, 204, { 'Content-Type': 'application/json' })
+      })
+      app.get('/not-modified', (c) => {
+        return c.body(null, 304, { 'Content-Type': 'application/json' })
+      })
+
+      const noContentRes = await app.request('http://localhost/no-content')
+      expect(noContentRes.status).toBe(204)
+      expect(await noContentRes.text()).toBe('')
+
+      const notModifiedRes = await app.request('http://localhost/not-modified')
+      expect(notModifiedRes.status).toBe(304)
+      expect(await notModifiedRes.text()).toBe('')
+    })
+
+    it('Should pass through an empty body with a JSON content-type', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('', 200, { 'Content-Type': 'application/json' })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a body that is not valid JSON', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/proxied', (c) => {
+        return c.body('<html>upstream error</html>', 502, {
+          'Content-Type': 'application/json',
+          'X-Upstream': 'yes',
+        })
+      })
+
+      const res = await app.request('http://localhost/proxied')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('X-Upstream')).toBe('yes')
+      expect(await res.text()).toBe('<html>upstream error</html>')
+    })
+
+    it('Should pass through a body that was already read by another middleware', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+    })
+
+    it('Should keep the original body and Content-Length for non-parsable bodies', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('not json', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '8',
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should remove Content-Length when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('{"message":"Hono!"}', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '18',
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+
+    it('Should keep other headers and the status when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('{"error":"nope"}', 418, {
+          'Content-Type': 'application/json',
+          'X-Custom': 'kept',
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(418)
+      expect(res.headers.get('X-Custom')).toBe('kept')
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe(`{
+  "error": "nope"
+}`)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..afcb087 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -51,9 +51,23 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
     const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+
+    let obj: unknown
+    try {
+      // Clone so the original response is left untouched when the body is not
+      // readable or not parsable as JSON (empty body, null body status, already
+      // consumed body, proxied non-JSON payload, ...).
+      obj = await c.res.clone().json()
+    } catch {
+      return
+    }
+
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    // The `c.res` setter copies the previous headers onto the new response, so
+    // Content-Length has to be removed after the assignment.
+    c.res.headers.delete('Content-Length')
   }
 }
