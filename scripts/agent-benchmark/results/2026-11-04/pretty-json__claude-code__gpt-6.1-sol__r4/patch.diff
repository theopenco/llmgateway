+  describe.each([
+    { name: 'query parameter', options: undefined, path: '/?pretty' },
+    { name: 'force option', options: { force: true }, path: '/' },
+  ])('When enabled by $name', ({ options, path }) => {
+    it.each([
+      { name: '204 with no body', status: 204, body: null },
+      { name: '304 with no body', status: 304, body: null },
+      { name: '200 with no body', status: 200, body: null },
+      { name: 'empty body', status: 200, body: '' },
+      { name: 'invalid JSON', status: 502, body: 'upstream error' },
+      { name: 'malformed JSON', status: 200, body: '{"message":' },
+    ])('Should preserve a response with $name', async ({ status, body }) => {
+      const app = new Hono()
+      const headers = {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body?.length ?? 0),
+        'X-Upstream': 'preserved',
+      }
+      const original = new Response(body, { status, headers })
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(path)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual([...new Headers(headers)])
+      expect(await res.text()).toBe(body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const app = new Hono()
+      const headers = {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+        'X-Upstream': 'preserved',
+      }
+      const original = new Response('{"message":"Hono!"}', { status: 201, headers })
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => original)
+
+      const res = await app.request(path)
+      expect(res).toBe(original)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual([...new Headers(headers)])
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when prettifying the body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response('{"message":"Hono!"}', {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': '19',
+              'X-Upstream': 'preserved',
+            },
+          })
+      )
+
+      const res = await app.request(path)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Upstream')).toBe('preserved')
+      expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+    })
+  })
+
