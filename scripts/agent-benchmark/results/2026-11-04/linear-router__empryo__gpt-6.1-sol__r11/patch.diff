+it('does not match an empty segment as a named parameter', () => {
+  const router = new LinearRouter<string>()
+  router.add('GET', '/u/:id/posts', 'posts')
+
+  expect(router.match('GET', '/u//posts')).toEqual([[]])
+  expect(router.match('GET', '/u/123/posts')).toEqual([[['posts', { id: '123' }]]])
+})
