+  it('Should leave responses with an empty body untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await notModifiedRes.text()).toBe('')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await emptyRes.text()).toBe('')
+  })
+
+  it('Should leave responses with an unparsable JSON body untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid', (c) =>
+      c.body('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Custom': 'kept',
+      })
+    )
+
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(res.headers.get('X-Custom')).toBe('kept')
+    expect(await res.text()).toBe('not json')
+  })
+
+  it('Should leave responses whose body was already read untouched', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+  })
+
+  it('Should remove the stale Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
