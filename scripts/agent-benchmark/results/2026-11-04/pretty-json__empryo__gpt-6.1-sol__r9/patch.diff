diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..d9b69a2 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,70 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe.each([
+  { name: 'query', options: undefined, url: '/?pretty' },
+  { name: 'force', options: { force: true }, url: '/' },
+])('JSON pretty with $name enabled', ({ options, url }) => {
+  it.each([
+    { name: '204 response', status: 204, body: null, consumed: false },
+    { name: '304 response', status: 304, body: null, consumed: false },
+    { name: 'empty body', status: 200, body: '', consumed: false },
+    { name: 'invalid JSON', status: 502, body: 'upstream error', consumed: false },
+    { name: 'already-read body', status: 200, body: '{"message":"Hono!"}', consumed: true },
+  ])('Should preserve $name unchanged', async ({ status, body, consumed }) => {
+    const app = new Hono()
+    const original = new Response(body, {
+      status,
+      headers: {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body?.length ?? 0),
+        'X-Upstream': 'preserved',
+      },
+    })
+    const headers = [...original.headers]
+    app.onError(() => new Response('Unexpected error', { status: 500 }))
+    app.use('*', prettyJSON(options))
+    app.use('*', async (c, next) => {
+      await next()
+      if (consumed) {
+        await c.res.text()
+      }
+    })
+    app.get('/', () => original)
+
+    const res = await app.request(url)
+    expect(res).toBe(original)
+    expect(res.status).toBe(status)
+    expect([...res.headers]).toEqual(headers)
+    expect(res.bodyUsed).toBe(consumed)
+    if (!consumed) {
+      expect(await res.text()).toBe(body ?? '')
+    }
+  })
+
+  it('Should remove Content-Length only when prettifying the body', async () => {
+    const app = new Hono()
+    const body = '{"message":"Hono!"}'
+    app.use('*', prettyJSON(options))
+    app.get(
+      '/',
+      () =>
+        new Response(body, {
+          status: 201,
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': String(body.length),
+            'X-Upstream': 'preserved',
+          },
+        })
+    )
+
+    const res = await app.request(url)
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Upstream')).toBe('preserved')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(JSON.stringify(JSON.parse(body), null, 2))
+  })
+})
