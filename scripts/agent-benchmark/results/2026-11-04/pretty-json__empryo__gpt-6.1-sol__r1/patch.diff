diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..0d2684e 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,79 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe.each([
+  { name: 'query', options: undefined, url: '/?pretty' },
+  { name: 'force', options: { force: true }, url: '/' },
+])('JSON pretty fallback with $name', ({ options, url }) => {
+  it.each([
+    { status: 204, body: null },
+    { status: 304, body: null },
+    { status: 200, body: null },
+    { status: 200, body: '' },
+    { status: 502, body: 'not valid JSON' },
+  ])('Should preserve status $status and body $body', async ({ status, body }) => {
+    const app = new Hono()
+    const original = new Response(body, {
+      status,
+      headers: {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body?.length ?? 0),
+        'X-Custom': 'preserved',
+      },
+    })
+    app.use('*', prettyJSON(options))
+    app.get('/', () => original)
+
+    const res = await app.request(url)
+    expect(res).toBe(original)
+    expect(res.status).toBe(status)
+    expect([...res.headers]).toEqual([...original.headers])
+    expect(res.headers.get('Content-Length')).toBe(String(body?.length ?? 0))
+    expect(await res.text()).toBe(body ?? '')
+  })
+
+  it('Should preserve a response already read by another middleware', async () => {
+    const app = new Hono()
+    const original = new Response('{"message":"Hono!"}', {
+      status: 201,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '19' },
+    })
+    app.use('*', prettyJSON(options))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', () => original)
+
+    const res = await app.request(url)
+    expect(res).toBe(original)
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Length')).toBe('19')
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length only when prettifying the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON(options))
+    app.get(
+      '/',
+      () =>
+        new Response('{"message":"Hono!"}', {
+          status: 201,
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': '19',
+            'X-Custom': 'preserved',
+          },
+        })
+    )
+
+    const res = await app.request(url)
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Custom')).toBe('preserved')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe('{\n  "message": "Hono!"\n}')
+  })
+})
