+
+  it('Should pass through empty and invalid JSON responses unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.body('', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Response': 'empty',
+    }))
+    app.get('/invalid', (c) => c.body('not JSON', 502, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Response': 'proxied',
+    }))
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(emptyRes.headers.get('X-Response')).toBe('empty')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Response')).toBe('proxied')
+    expect(await invalidRes.text()).toBe('not JSON')
+  })
+
+  it('Should pass through bodyless JSON responses unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Response': 'no-content',
+    }))
+    app.get('/not-modified', (c) => c.body(null, 304, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Response': 'not-modified',
+    }))
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Length')).toBe('0')
+    expect(noContentRes.headers.get('X-Response')).toBe('no-content')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Length')).toBe('0')
+    expect(notModifiedRes.headers.get('X-Response')).toBe('not-modified')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through a response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }, 202, {
+      'X-Response': 'read',
+    }))
+
+    const res = await app.request('http://localhost/')
+
+    expect(res.status).toBe(202)
+    expect(res.headers.get('Content-Type')).toContain('application/json')
+    expect(res.headers.get('X-Response')).toBe('read')
+  })
 })
