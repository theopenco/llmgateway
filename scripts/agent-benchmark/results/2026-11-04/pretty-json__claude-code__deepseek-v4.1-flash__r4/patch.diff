+  it('Should pass through JSON content-types with no body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/not-modified', (c) =>
+      c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+    )
+    app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(notModifiedRes.headers.get('ETag')).toBe('"abc"')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(await emptyRes.text()).toBe('')
+  })
+
+  it('Should pass through JSON content-types with an invalid JSON body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/proxy', () => {
+      return new Response('<html>Bad Gateway</html>', {
+        status: 502,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '23',
+          'X-Origin': 'upstream',
+        },
+      })
+    })
+
+    const res = await app.request('http://localhost/proxy')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('23')
+    expect(res.headers.get('X-Origin')).toBe('upstream')
+    expect(await res.text()).toBe('<html>Bad Gateway</html>')
+  })
+
+  it('Should pass through a JSON response whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should remove the original Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.body('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
