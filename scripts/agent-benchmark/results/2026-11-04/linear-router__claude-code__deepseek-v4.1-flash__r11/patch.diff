+  describe('Empty path segment', () => {
+    const newRouter = () => {
+      const router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/n/:id{[0-9]+}/suffix', 'GET /n/:id{[0-9]+}/suffix')
+      return router
+    }
+
+    const match = (path: string) => {
+      const [res] = newRouter().match('GET', path)
+      return res.map(([handler, params]) => [handler, { ...params }])
+    }
+
