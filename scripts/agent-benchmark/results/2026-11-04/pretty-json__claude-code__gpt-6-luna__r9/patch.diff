+  it('Should pass through JSON responses that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'preserved',
+      })
+    )
+    app.get('/empty', (c) =>
+      c.newResponse('', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/no-content', (c) =>
+      c.newResponse(null, 204, {
+        'Content-Type': 'application/json',
+        'Content-Length': '0',
+      })
+    )
+    app.get('/not-modified', (c) =>
+      c.newResponse(null, 304, {
+        'Content-Type': 'application/json',
+        'X-Test': 'preserved',
+      })
+    )
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('preserved')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(await emptyRes.text()).toBe('')
+
+    const noContentRes = await app.request('http://localhost/no-content')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Length')).toBe('0')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('X-Test')).toBe('preserved')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should remove Content-Length when prettifying a response', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should not fail when another middleware has read the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 201, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+        'X-Test': 'preserved',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(201)
+    expect(res.headers.get('Content-Length')).toBe('18')
+    expect(res.headers.get('X-Test')).toBe('preserved')
+    expect(res.bodyUsed).toBe(true)
+  })
+
