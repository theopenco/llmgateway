diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..5a3db29 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,62 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe('JSON pretty by Middleware - unparsable bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', (c) => c.body(null, 204, { 'Content-Type': 'application/json' }))
+  app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+  app.get('/empty', (c) => c.body('', 200, { 'Content-Type': 'application/json' }))
+  app.get('/invalid', (c) =>
+    c.body('{"broken":', 502, { 'Content-Type': 'application/json', 'Content-Length': '10' })
+  )
+  app.get('/consumed', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+  app.get('/sized', (c) =>
+    c.body('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    })
+  )
+
+  it.each([
+    ['/no-content', 204],
+    ['/not-modified', 304],
+  ])('Should pass through %s with no body', async (path, status) => {
+    const res = await app.request(`http://localhost${path}`)
+    expect(res.status).toBe(status)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through an empty body unchanged', async () => {
+    const res = await app.request('http://localhost/empty')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body with its headers unchanged', async () => {
+    const res = await app.request('http://localhost/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('10')
+    expect(await res.text()).toBe('{"broken":')
+  })
+
+  it('Should not throw when the body was already read by another middleware', async () => {
+    const res = await app.request('http://localhost/consumed')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const res = await app.request('http://localhost/sized')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
