+  describe('Empty path segment', () => {
+    let router: LinearRouter<string>
+
+    beforeEach(() => {
+      router = new LinearRouter<string>()
+      router.add('GET', '/u/:id/posts', 'GET /u/:id/posts')
+      router.add('GET', '/:a/:b', 'GET /:a/:b')
+      router.add('GET', '/:a/posts', 'GET /:a/posts')
+      router.add('GET', '/u/:id{[a-z]+}/posts', 'GET /u/:id{[a-z]+}/posts')
+    })
+
+    it('GET /u//posts', () => {
+      expect(router.match('GET', '/u//posts')[0]).toEqual([])
+    })
+
+    it('GET /u///posts', () => {
+      expect(router.match('GET', '/u///posts')[0]).toEqual([])
+    })
+
+    it('GET /a//b', () => {
+      expect(router.match('GET', '/a//b')[0]).toEqual([])
+    })
+
+    it('GET //posts', () => {
+      expect(router.match('GET', '//posts')[0]).toEqual([])
+    })
+
+    it('GET /u/x/posts still matches', () => {
+      const [res] = router.match('GET', '/u/x/posts')
+      expect(res.length).toBe(2)
+      expect(res.map(([handler]) => handler)).toEqual([
+        'GET /u/:id/posts',
+        'GET /u/:id{[a-z]+}/posts',
+      ])
+      expect(res[0][1]).toEqual({ id: 'x' })
+    })
+  })
