+  it('Should pass through responses with empty or invalid JSON bodies', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json', 'X-Test': 'empty' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not JSON', 502, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+        'X-Test': 'invalid',
+      })
+    )
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(204)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(emptyRes.headers.get('X-Test')).toBe('empty')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json')
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('invalid')
+    expect(await invalidRes.text()).toBe('not JSON')
+  })
+
+  it('Should pass through responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 202, { 'Content-Type': 'application/json' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(202)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.bodyUsed).toBe(true)
+  })
 })
