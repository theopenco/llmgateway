diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..efe6993 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,62 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('responses with a JSON content-type but no parseable body pass through unchanged', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+
+    app.get('/204', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/304', (c) => c.newResponse(null, 304, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, { 'Content-Type': 'application/json' })
+    )
+
+    const cases: [string, number, string][] = [
+      ['/204', 204, ''],
+      ['/304', 304, ''],
+      ['/empty', 200, ''],
+      ['/invalid', 200, 'not json'],
+    ]
+
+    cases.forEach(([path, status, body]) => {
+      it(path, async () => {
+        const res = await app.request(`http://localhost${path}`)
+        expect(res.status).toBe(status)
+        expect(await res.text()).toBe(body)
+      })
+    })
+
+    it('does not throw when another middleware already read the body', async () => {
+      const localApp = new Hono()
+      localApp.use('*', prettyJSON({ force: true }))
+      localApp.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      localApp.get('/', (c) => c.json({ message: 'Hono!' }))
+
+      const res = await localApp.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+    })
+  })
+
+  it('removes the original Content-Length header when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      return c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
