diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..5d94185 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,73 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through responses with a JSON content-type but a body that cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+
+    app.get('/204', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('not json', 200, { 'Content-Type': 'application/json' })
+    )
+
+    const res204 = await app.request('http://localhost/204')
+    expect(res204.status).toBe(204)
+    expect(res204.headers.get('Content-Type')).toBe('application/json')
+    expect(await res204.text()).toBe('')
+
+    const resEmpty = await app.request('http://localhost/empty')
+    expect(resEmpty.status).toBe(200)
+    expect(await resEmpty.text()).toBe('')
+
+    const resInvalid = await app.request('http://localhost/invalid')
+    expect(resInvalid.status).toBe(200)
+    expect(await resInvalid.text()).toBe('not json')
+  })
+
+  it('Should pass through responses whose body was already read by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+  })
+
+  it('Should remove the original Content-Length header when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '18',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+
+  it('Should keep the Content-Length header when the body is not prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) =>
+      c.newResponse('not json', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '8',
+      })
+    )
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBe('8')
+    expect(await res.text()).toBe('not json')
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..8b244e9 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,14 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      try {
+        const obj = await c.res.clone().json()
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+        c.res.headers.delete('Content-Length')
+      } catch {
+        // The body cannot be parsed as JSON (e.g. empty body, invalid JSON,
+        // or already consumed). Pass the response through unchanged.
+      }
     }
   }
 }
