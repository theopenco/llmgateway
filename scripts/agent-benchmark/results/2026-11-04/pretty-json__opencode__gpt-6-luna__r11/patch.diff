diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..19bca37 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,71 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses that cannot be prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse(null, 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '0',
+      'X-Original': 'kept',
+    }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '8',
+      'X-Original': 'kept',
+    }))
+    app.get('/no-content', (c) => c.newResponse(null, 204, {
+      'Content-Type': 'application/json',
+      'X-Original': 'kept',
+    }))
+    app.get('/not-modified', (c) => c.newResponse(null, 304, {
+      'Content-Type': 'application/json',
+      'X-Original': 'kept',
+    }))
+    app.get('/consumed', (c) => {
+      const res = c.newResponse('{"message":"Hono!"}', 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': '19',
+        'X-Original': 'kept',
+      })
+      void res.text()
+      return res
+    })
+
+    for (const [path, status, body, contentLength] of [
+      ['/empty', 200, '', '0'],
+      ['/invalid', 200, 'not json', '8'],
+      ['/no-content', 204, '', null],
+      ['/not-modified', 304, '', null],
+    ] as const) {
+      const res = await app.request(`http://localhost${path}`)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe(contentLength)
+      expect(res.headers.get('X-Original')).toBe('kept')
+      expect(await res.text()).toBe(body)
+    }
+
+    const consumedRes = await app.request('http://localhost/consumed')
+    expect(consumedRes.status).toBe(200)
+    expect(consumedRes.headers.get('Content-Type')).toBe('application/json')
+    expect(consumedRes.headers.get('Content-Length')).toBe('19')
+    expect(consumedRes.headers.get('X-Original')).toBe('kept')
+  })
+
+  it('Should remove Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"message":"Hono!"}', 200, {
+      'Content-Type': 'application/json',
+      'Content-Length': '19',
+    }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
