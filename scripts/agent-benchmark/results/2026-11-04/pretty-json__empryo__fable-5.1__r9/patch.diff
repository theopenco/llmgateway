diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..065a788 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,88 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through JSON responses that have no body (204 / 304)', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/no-content', (c) => {
+      return c.body(null, 204, { 'Content-Type': 'application/json' })
+    })
+    app.get('/not-modified', (c) => {
+      return c.body(null, 304, { 'Content-Type': 'application/json', ETag: '"abc"' })
+    })
+
+    const noContentRes = await app.request('http://localhost/no-content?pretty')
+    expect(noContentRes.status).toBe(204)
+    expect(noContentRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await noContentRes.text()).toBe('')
+
+    const notModifiedRes = await app.request('http://localhost/not-modified?pretty')
+    expect(notModifiedRes.status).toBe(304)
+    expect(notModifiedRes.headers.get('ETag')).toBe('"abc"')
+    expect(await notModifiedRes.text()).toBe('')
+  })
+
+  it('Should pass through JSON responses with an empty or invalid body unchanged', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => {
+      return c.body('', 200, { 'Content-Type': 'application/json' })
+    })
+    app.get('/invalid', (c) => {
+      return c.body('{"broken":', 502, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Content-Length': '10',
+        'X-Upstream': 'proxy',
+      })
+    })
+
+    const emptyRes = await app.request('http://localhost/empty?pretty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid?pretty')
+    expect(invalidRes.status).toBe(502)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json; charset=utf-8')
+    expect(invalidRes.headers.get('Content-Length')).toBe('10')
+    expect(invalidRes.headers.get('X-Upstream')).toBe('proxy')
+    expect(await invalidRes.text()).toBe('{"broken":')
+  })
+
+  it('Should not throw when the body was already consumed by another middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/?pretty')
+    expect(res.status).toBe(200)
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should drop the original Content-Length when the body is prettified', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => {
+      const body = '{"message":"Hono!"}'
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+        'X-Custom': 'kept',
+      })
+    })
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Custom')).toBe('kept')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..1037a00 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -50,10 +50,34 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
   return async function prettyJSON(c, next) {
     const pretty = options?.force || c.req.query(targetQuery) || c.req.query(targetQuery) === ''
     await next()
-    const contentType = c.res.headers.get('Content-Type')
-    if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+    const res = c.res
+    const contentType = res.headers.get('Content-Type')
+    if (!pretty || !contentType || !jsonContentTypeRegex.test(contentType)) {
+      return
     }
+    // Nothing to prettify (e.g. 204/304) or the body was already consumed elsewhere.
+    if (!res.body || res.bodyUsed) {
+      return
+    }
+    const text = await res.text()
+    let obj: unknown
+    try {
+      obj = JSON.parse(text)
+    } catch {
+      // Not valid JSON: pass the original response through unchanged.
+      c.res = new Response(text, res)
+      return
+    }
+    const headers = new Headers(res.headers)
+    // The prettified body has a different length than the original one.
+    headers.delete('Content-Length')
+    // Reset first: the `c.res` setter merges headers of the previous response into the new one,
+    // which would bring the stale Content-Length back.
+    c.res = undefined
+    c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+      status: res.status,
+      statusText: res.statusText,
+      headers,
+    })
   }
 }
