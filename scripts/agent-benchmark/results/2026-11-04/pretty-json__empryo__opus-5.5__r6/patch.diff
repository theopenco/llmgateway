+
+describe('JSON pretty by Middleware - unparsable JSON bodies', () => {
+  const app = new Hono()
+  app.use('*', prettyJSON({ force: true }))
+  app.get('/no-content', (c) =>
+    c.body(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+  )
+  app.get('/not-modified', (c) => c.body(null, 304, { 'Content-Type': 'application/json' }))
+  app.get('/empty', (c) =>
+    c.body('', 200, { 'Content-Type': 'application/json', 'Content-Length': '0' })
+  )
+  app.get('/invalid', () =>
+    new Response('not json {', {
+      status: 502,
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '10', 'X-Upstream': '1' },
+    })
+  )
+  app.get('/consumed', async (c, next) => {
+    await next()
+    await c.res.text()
+  })
+  app.get('/consumed', (c) => c.json({ message: 'Hono!' }))
+  app.get('/valid', () =>
+    new Response('{"message":"Hono!"}', {
+      headers: { 'Content-Type': 'application/json', 'Content-Length': '19' },
+    })
+  )
+
+  it('Should pass through 204 with JSON content-type unchanged', async () => {
+    const res = await app.request('/no-content')
+    expect(res.status).toBe(204)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through 304 with JSON content-type unchanged', async () => {
+    const res = await app.request('/not-modified')
+    expect(res.status).toBe(304)
+    expect(res.body).toBeNull()
+  })
+
+  it('Should pass through an empty JSON body unchanged', async () => {
+    const res = await app.request('/empty')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBe('0')
+    expect(await res.text()).toBe('')
+  })
+
+  it('Should pass through an invalid JSON body unchanged', async () => {
+    const res = await app.request('/invalid')
+    expect(res.status).toBe(502)
+    expect(res.headers.get('Content-Length')).toBe('10')
+    expect(res.headers.get('X-Upstream')).toBe('1')
+    expect(await res.text()).toBe('not json {')
+  })
+
+  it('Should not throw when the body was already consumed', async () => {
+    const res = await app.request('/consumed')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+  })
+
+  it('Should remove Content-Length when the body is prettified', async () => {
+    const res = await app.request('/valid')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
+})
+
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
index bc1a9b9..cce9177 100644
--- a/src/middleware/pretty-json/index.ts
+++ b/src/middleware/pretty-json/index.ts
@@ -52,8 +52,27 @@ export const prettyJSON = (options?: PrettyOptions): MiddlewareHandler => {
     await next()
     const contentType = c.res.headers.get('Content-Type')
     if (pretty && contentType && jsonContentTypeRegex.test(contentType)) {
-      const obj = await c.res.json()
-      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), c.res)
+      const res = c.res
+      // Leave responses whose body is absent, already consumed or not valid JSON untouched.
+      if (res.body === null || res.bodyUsed) {
+        return
+      }
+      let obj: unknown
+      try {
+        obj = JSON.parse(await res.clone().text())
+      } catch {
+        return
+      }
+      const headers = new Headers(res.headers)
+      // The prettified body has a different length.
+      headers.delete('Content-Length')
+      // Reset first so the setter does not merge the old headers (incl. Content-Length) back in.
+      c.res = undefined
+      c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+        status: res.status,
+        statusText: res.statusText,
+        headers,
+      })
     }
   }
 }
