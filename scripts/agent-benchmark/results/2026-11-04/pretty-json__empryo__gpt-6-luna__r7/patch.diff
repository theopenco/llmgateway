--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,57 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+
+describe('prettyJSON invalid JSON responses', () => {
+  it('passes through JSON responses whose bodies cannot be parsed', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/empty', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json', 'Content-Length': '0' }))
+    app.get('/invalid', (c) => c.newResponse('not json', 200, { 'Content-Type': 'application/json', 'Content-Length': '8', 'X-Test': 'original' }))
+    app.get('/malformed-proxy', () => new Response('proxy body', { headers: { 'Content-Type': 'application/json', 'X-Test': 'proxy' } }))
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(204)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(emptyRes.headers.get('Content-Length')).toBe('0')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(invalidRes.headers.get('Content-Length')).toBe('8')
+    expect(invalidRes.headers.get('X-Test')).toBe('original')
+    expect(await invalidRes.text()).toBe('not json')
+
+    const proxyRes = await app.request('http://localhost/malformed-proxy')
+    expect(proxyRes.status).toBe(200)
+    expect(proxyRes.headers.get('X-Test')).toBe('proxy')
+    expect(await proxyRes.text()).toBe('proxy body')
+  })
+
+  it('passes through JSON responses whose body was already read', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.clone().text()
+    })
+    app.get('/', (c) => c.newResponse('already read', 200, { 'Content-Type': 'application/json', 'X-Test': 'original' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('X-Test')).toBe('original')
+    expect(await res.text()).toBe('already read')
+  })
+
+  it('removes Content-Length when prettifying JSON', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', (c) => c.newResponse('{"a":1}', 200, { 'Content-Type': 'application/json', 'Content-Length': '7' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(await res.text()).toBe('{\n  "a": 1\n}')
+  })
+})
+
