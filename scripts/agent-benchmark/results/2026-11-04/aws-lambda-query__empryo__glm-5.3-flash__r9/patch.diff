+describe('getQueryString with empty and undefined query parameter values', () => {
+  it('Should keep empty-string values and skip undefined ones for version 1.0 API Gateway event', () => {
+    const event: LambdaEvent = {
+      ...baseV1Event,
+      queryStringParameters: {
+        empty: '',
+        present: '0',
+        omitted: undefined,
+      },
+    }
+
+    const processor = getProcessor(event)
+    const request = processor.createRequest(event)
+
+    expect(request.url).toEqual('https://id.execute-api.us-east-1.amazonaws.com/my/path?empty=&present=0')
+  })
+
+  it('Should keep empty-string values and skip undefined ones for ALB event', () => {
+    const event: LambdaEvent = {
+      httpMethod: 'GET',
+      headers: {
+        host: 'my-targets-73e2d6bc24d8a067.us-east-1.elb.amazonaws.com',
+      },
+      path: '/my/path',
+      body: null,
+      isBase64Encoded: false,
+      queryStringParameters: {
+        empty: '',
+        present: '0',
+        omitted: undefined,
+      },
+      requestContext: {
+        elb: {
+          targetGroupArn: 'arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/my-targets/73e2d6bc24d8a067',
+        },
+      },
+    }
+
+    const processor = getProcessor(event)
+    const request = processor.createRequest(event)
+
+    expect(request.url).toEqual('https://my-targets-73e2d6bc24d8a067.us-east-1.elb.amazonaws.com/my/path?empty=&present=0')
+  })
+})
