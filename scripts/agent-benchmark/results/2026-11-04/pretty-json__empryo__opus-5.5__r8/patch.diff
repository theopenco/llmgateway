+      const res = c.res
+        if (!res.body || res.bodyUsed) {
+          return
+        }
+        const buffer = await res.arrayBuffer()
+        let obj: unknown
+        try {
+          obj = JSON.parse(new TextDecoder().decode(buffer))
+        } catch {
+          // Not valid JSON: pass the original body through unchanged
+          c.res = new Response(buffer, res)
+          return
+        }
+        const headers = new Headers(res.headers)
+        headers.delete('Content-Length')
+        // Reset first: the `c.res` setter merges the previous response's headers,
+        // which would bring back the stale Content-Length
+        c.res = undefined
+        c.res = new Response(JSON.stringify(obj, null, options?.space ?? 2), {
+          status: res.status,
+          statusText: res.statusText,
+          headers,
+        })
     }
   }
 }
