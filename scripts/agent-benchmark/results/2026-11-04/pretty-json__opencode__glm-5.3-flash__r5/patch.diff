diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..cf842f3 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,62 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  it('Should pass through responses with a JSON content-type but no parsable body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', (c) => c.newResponse(null, 204, { 'Content-Type': 'application/json' }))
+    app.get('/empty', (c) => c.newResponse('', 200, { 'Content-Type': 'application/json' }))
+    app.get('/invalid', (c) =>
+      c.newResponse('This is not JSON', 200, { 'Content-Type': 'application/json' })
+    )
+
+    const res204 = await app.request('http://localhost/204')
+    expect(res204.status).toBe(204)
+    expect(res204.headers.get('Content-Type')).toBe('application/json')
+    expect(await res204.text()).toBe('')
+
+    const emptyRes = await app.request('http://localhost/empty')
+    expect(emptyRes.status).toBe(200)
+    expect(emptyRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await emptyRes.text()).toBe('')
+
+    const invalidRes = await app.request('http://localhost/invalid')
+    expect(invalidRes.status).toBe(200)
+    expect(invalidRes.headers.get('Content-Type')).toBe('application/json')
+    expect(await invalidRes.text()).toBe('This is not JSON')
+  })
+
+  it('Should pass through a response whose body was already read by another middleware', async () => {
+    const app = new Hono()
+    let readBody: string | undefined
+    app.use('*', prettyJSON({ force: true }))
+    app.use('*', async (c, next) => {
+      await next()
+      readBody = await c.res.text()
+    })
+    app.get('/', (c) => c.json({ message: 'Hono!' }))
+
+    const res = await app.request('http://localhost/')
+    expect(res.status).toBe(200)
+    expect(readBody).toBe('{"message":"Hono!"}')
+  })
+
+  it('Should remove the Content-Length header when prettifying the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON())
+    app.get('/', (c) => {
+      const body = JSON.stringify({ message: 'Hono!' })
+      return c.body(body, 200, {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      })
+    })
+
+    const res = await app.request('http://localhost/?pretty')
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
