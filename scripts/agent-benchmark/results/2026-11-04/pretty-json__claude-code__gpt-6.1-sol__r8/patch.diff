+  describe.each([
+    { name: 'query parameter', options: {}, url: '/?pretty' },
+    { name: 'force option', options: { force: true }, url: '/' },
+  ])('When enabled by $name', ({ options, url }) => {
+    it.each([
+      { status: 204, body: null, contentLength: '0' },
+      { status: 304, body: null, contentLength: '123' },
+      { status: 200, body: null, contentLength: '0' },
+      { status: 200, body: '', contentLength: '0' },
+      { status: 502, body: 'Bad Gateway', contentLength: '11' },
+    ])('Should preserve an unparseable response: $status, $body', async (init) => {
+      const original = new Response(init.body, {
+        status: init.status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': init.contentLength,
+          'X-Custom': 'unchanged',
+        },
+      })
+      const headers = [...original.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(init.status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(init.body ?? '')
+    })
+
+    it('Should preserve a response already read by another middleware', async () => {
+      const original = new Response('{"message":"Hono!"}', {
+        status: 201,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': '19',
+          'X-Custom': 'unchanged',
+        },
+      })
+      const headers = [...original.headers]
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.use('*', async (c, next) => {
+        await next()
+        await c.res.text()
+      })
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(201)
+      expect([...res.headers]).toEqual(headers)
+      expect(res.bodyUsed).toBe(true)
+    })
+
+    it('Should remove Content-Length only when the body is prettified', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      app.get(
+        '/',
+        () =>
+          new Response('{"message":"Hono!"}', {
+            status: 201,
+            headers: {
+              'Content-Type': 'application/json',
+              'Content-Length': '19',
+              'X-Custom': 'unchanged',
+            },
+          })
+      )
+
+      const res = await app.request(url)
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(res.headers.get('X-Custom')).toBe('unchanged')
+      expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+    })
+  })
+
