diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..a31f8c9 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,91 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('JSON content-type with a body that cannot be parsed', () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/204', () => new Response(null, { status: 204, headers: { 'Content-Type': 'application/json' } }))
+    app.get('/304', () => new Response(null, { status: 304, headers: { 'Content-Type': 'application/json' } }))
+    app.get(
+      '/empty',
+      () =>
+        new Response('', {
+          status: 200,
+          headers: { 'Content-Type': 'application/json', 'Content-Length': '0' },
+        })
+    )
+    app.get(
+      '/invalid',
+      () =>
+        new Response('not json', {
+          status: 502,
+          headers: { 'Content-Type': 'application/json', 'Content-Length': '8', 'X-Custom': 'a' },
+        })
+    )
+    app.get(
+      '/consumed',
+      async (c, next) => {
+        await next()
+        await c.res.text()
+      },
+      (c) => c.json({ message: 'Hono!' }, 201)
+    )
+
+    it.each([
+      ['/204', 204],
+      ['/304', 304],
+    ])('Should pass %s through unchanged', async (path, status) => {
+      const res = await app.request(path)
+      expect(res.status).toBe(status)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass an empty body through unchanged', async () => {
+      const res = await app.request('/empty')
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Content-Length')).toBe('0')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass an invalid JSON body through unchanged', async () => {
+      const res = await app.request('/invalid')
+      expect(res.status).toBe(502)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(res.headers.get('Content-Length')).toBe('8')
+      expect(res.headers.get('X-Custom')).toBe('a')
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should pass a response whose body was already read through unchanged', async () => {
+      const res = await app.request('/consumed')
+      expect(res.status).toBe(201)
+      expect(res.headers.get('Content-Type')).toMatch(/^application\/json/)
+    })
+  })
+
+  it('Should remove the original Content-Length when prettifying', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON({ force: true }))
+    app.get('/', () => {
+      const body = '{"message":"Hono!"}'
+      return new Response(body, {
+        status: 200,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body.length),
+          'X-Custom': 'a',
+        },
+      })
+    })
+
+    const res = await app.request('/')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Content-Length')).toBeNull()
+    expect(res.headers.get('X-Custom')).toBe('a')
+    expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
