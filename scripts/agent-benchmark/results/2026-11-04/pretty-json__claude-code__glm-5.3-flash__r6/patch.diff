diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..0e05f2f 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -119,4 +119,75 @@ describe('JSON pretty by Middleware', () => {
     const jsonSeqRes = await app.request('http://localhost/json-seq')
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
+
+  describe('Should pass through responses with unparsable JSON bodies', () => {
+    it('Should pass through a 204 response with a JSON content-type and no body', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body(null, 204, { 'Content-Type': 'application/json' })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(204)
+      expect(res.headers.get('Content-Type')).toBe('application/json')
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through an empty 200 response with a JSON content-type', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('', 200, { 'Content-Type': 'application/json' })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(await res.text()).toBe('')
+    })
+
+    it('Should pass through a response whose body is not valid JSON', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.body('not json', 200, { 'Content-Type': 'application/json' })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+      expect(await res.text()).toBe('not json')
+    })
+
+    it('Should pass through a response whose body was already consumed', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', async (c) => {
+        const res = new Response('{"message":"Hono!"}', {
+          headers: { 'Content-Type': 'application/json' },
+        })
+        await res.text()
+        return res
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.status).toBe(200)
+    })
+
+    it('Should remove the original Content-Length when prettifying', async () => {
+      const app = new Hono()
+      app.use('*', prettyJSON({ force: true }))
+      app.get('/', (c) => {
+        return c.newResponse('{"message":"Hono!"}', 200, {
+          'Content-Type': 'application/json',
+          'Content-Length': '18',
+        })
+      })
+
+      const res = await app.request('http://localhost/')
+      expect(res.headers.get('Content-Length')).toBeNull()
+      expect(await res.text()).toBe(`{
+  "message": "Hono!"
+}`)
+    })
+  })
 })
diff --git a/src/middleware/pretty-json/index.ts b/src/middleware/pretty-json/index.ts
