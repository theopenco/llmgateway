+
+describe('LinearRouter parameter segments', () => {
+  it.each([
+    ['/:id/posts', '//posts', '/123/posts'],
+    ['/u/:id/posts', '/u//posts', '/u/123/posts'],
+    ['/u/:id', '/u/', '/u/123'],
+  ])('rejects empty parameters for %s', (route, emptyPath, validPath) => {
+    const router = new LinearRouter<string>()
+    router.add('GET', route, 'handler')
+
+    expect(router.match('GET', emptyPath)[0]).toEqual([])
+    expect(router.match('GET', validPath)[0]).toEqual([['handler', { id: '123' }]])
+  })
+})
