diff --git a/src/middleware/pretty-json/index.test.ts b/src/middleware/pretty-json/index.test.ts
index 70b44b6..ef130e2 100644
--- a/src/middleware/pretty-json/index.test.ts
+++ b/src/middleware/pretty-json/index.test.ts
@@ -120,3 +120,86 @@ describe('JSON pretty by Middleware', () => {
     expect(await jsonSeqRes.text()).toBe('{"message":"Hono!"}')
   })
 })
+
+describe.each([{ force: false }, { force: true }])('JSON pretty fallback with %o', (options) => {
+  const url = options.force ? '/' : '/?pretty'
+
+  it.each([
+    { status: 204, body: null },
+    { status: 304, body: null },
+    { status: 200, body: '' },
+    { status: 502, body: '<html>Bad Gateway</html>' },
+  ])(
+    'Should preserve an unparseable response with status $status and body $body',
+    async ({ status, body }) => {
+      const app = new Hono()
+      app.use('*', prettyJSON(options))
+      const original = new Response(body, {
+        status,
+        headers: {
+          'Content-Type': 'application/json',
+          'Content-Length': String(body?.length ?? 0),
+          'X-Upstream': 'preserved',
+        },
+      })
+      const headers = [...original.headers]
+      app.get('/', () => original)
+
+      const res = await app.request(url)
+      expect(res).toBe(original)
+      expect(res.status).toBe(status)
+      expect([...res.headers]).toEqual(headers)
+      expect(await res.text()).toBe(body ?? '')
+    }
+  )
+
+  it('Should preserve a response whose body was already read by middleware', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON(options))
+    app.use('*', async (c, next) => {
+      await next()
+      await c.res.text()
+    })
+    const body = '{"message":"Hono!"}'
+    const original = new Response(body, {
+      status: 202,
+      headers: {
+        'Content-Type': 'application/json',
+        'Content-Length': String(body.length),
+      },
+    })
+    const headers = [...original.headers]
+    app.get('/', () => original)
+
+    const res = await app.request(url)
+    expect(res).toBe(original)
+    expect(res.status).toBe(202)
+    expect([...res.headers]).toEqual(headers)
+    expect(res.bodyUsed).toBe(true)
+  })
+
+  it('Should remove Content-Length only when prettifying the body', async () => {
+    const app = new Hono()
+    app.use('*', prettyJSON(options))
+    const body = '{"message":"Hono!"}'
+    app.get(
+      '/',
+      () =>
+        new Response(body, {
+          status: 201,
+          headers: {
+            'Content-Type': 'application/json',
+            'Content-Length': String(body.length),
+            'X-Upstream': 'preserved',
+          },
+        })
+    )
+
+    const res = await app.request(url)
+    expect(res.status).toBe(201)
+    expect(res.headers.has('Content-Length')).toBe(false)
+    expect(res.headers.get('Content-Type')).toBe('application/json')
+    expect(res.headers.get('X-Upstream')).toBe('preserved')
+    expect(await res.text()).toBe(JSON.stringify({ message: 'Hono!' }, null, 2))
+  })
+})
