{
	"name": "airside",
	"version": "0.0.0",
	"private": true,
	"license": "SEE LICENSE IN ../../LICENSE",
	"files": [
		"public",
		".next"
	],
	"scripts": {
		"build": "pnpm generate && next build --turbopack && tsc && mkdir -p .next/static && cp -r .next/static .next/standalone/apps/airside/.next/ && test -d public && cp -r public .next/standalone/apps/airside/",
		"dev": "next dev --port ${AIRSIDE_PORT:-3007} --turbopack",
		"format": "eslint --fix . && prettier --write .",
		"generate": "openapi-typescript ../api/openapi.json -o ./src/lib/api/v1.d.ts",
		"lint": "eslint . && prettier --check .",
		"start": "next start",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@better-auth/passkey": "1.6.26",
		"@hookform/resolvers": "5.2.2",
